<% if (activeSection === 'keuangan') { %>
<script>
    (() => {
        // Render nilai lebar bar & sudut donut dari atribut data-*
        document.querySelectorAll('[data-donut-deg]').forEach(el => {
            const deg = Number.parseFloat(el.getAttribute('data-donut-deg')) || 0;
