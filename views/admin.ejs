<%
const activeSection = typeof section !== 'undefined' && section ? section : 'ringkasan';
const pageTitles = {
    'ringkasan': {
        title: 'Ringkasan Dashboard',
        heading: 'Selamat datang, ' + user.username,
        sub: 'Ringkasan aktivitas, layanan warga, dan informasi ' + desa.nama + '.'
    },
    'kependudukan': {
        title: 'Grafik Kependudukan',
        heading: 'Grafik & Hitung Kependudukan',
        sub: 'Visualisasi dan kalkulator otomatis data penduduk ' + desa.nama + ' per dusun.'
    },
    'keuangan': {
        title: 'Administrasi Dana Desa',
        heading: 'Manajemen Administrasi Dana Masuk & Keluar',
        sub: 'Catat pemasukan, pengeluaran, serta pantau saldo dan arus kas ' + desa.nama + ' secara otomatis.'
    },
    'bantuan-desa': {
        title: 'Penerima Bantuan Desa',
        heading: 'Manajemen Data Warga Penerima Bantuan',
        sub: 'Kelola pendataan warga yang membutuhkan bantuan sosial, kriteria kelayakan, dan status penyalurannya.'
    },
    'terbitkan-berita': {
        title: 'Terbitkan Berita',
        heading: 'Terbitkan Berita Baru',
        sub: 'Buat dan publikasikan berita atau pengumuman terbaru untuk warga desa.'
    },
    'laporan-warga': {
        title: 'Laporan Warga',
        heading: 'Laporan & Aspirasi Masuk',
        sub: 'Daftar laporan, keluhan, dan saran yang dikirimkan oleh warga.'
    },
    'surat-pengantar': {
        title: 'Surat Pengantar',
        heading: 'Pengajuan Surat Pengantar',
        sub: 'Verifikasi, konfirmasi, atau tolak permohonan surat pengantar dari warga.'
    },
    'kelola-galeri': {
        title: 'Kelola Galeri',
        heading: 'Kelola Galeri Kegiatan',
        sub: 'Unggah dokumentasi foto kegiatan desa untuk ditampilkan di galeri publik.'
    },
    'daftar-berita': {
        title: 'Daftar Berita',
        heading: 'Daftar Berita Desa',
        sub: 'Kelola, sunting, atau hapus berita yang sudah diterbitkan.'
    }
};
const pageMeta = pageTitles[activeSection] || pageTitles['ringkasan'];

const imgSrc = foto => /^https?:\/\//i.test(foto) ? foto : '/' + foto;
const daftarBerita = berita || [];
const daftarGaleri = galeri || [];
const daftarLaporan = laporanWarga || [];
const daftarSurat = suratPengantar || [];
const suratMenunggu = daftarSurat.filter(s => (s.status || 'Menunggu') === 'Menunggu').length;
const statusBadge = status => status === 'Ditolak' ? 'badge-danger' : (status === 'Disetujui' ? 'badge-success' : 'badge-warning');
const dataPenduduk = (typeof kependudukan !== 'undefined' && Array.isArray(kependudukan) && kependudukan.length) ? kependudukan : [
    { dusun: 'Dusun Karang', laki_laki: 620, perempuan: 605, kk: 340, balita: 95, anak_remaja: 260, dewasa: 710, lansia: 160 },
    { dusun: 'Dusun Mulyo', laki_laki: 590, perempuan: 580, kk: 325, balita: 88, anak_remaja: 245, dewasa: 690, lansia: 147 },
    { dusun: 'Dusun Makmur', laki_laki: 555, perempuan: 550, kk: 310, balita: 82, anak_remaja: 230, dewasa: 655, lansia: 138 }
];
const totalPopulasi = dataPenduduk.reduce((acc, r) => acc + (Number(r.laki_laki) || 0) + (Number(r.perempuan) || 0), 0);
const totalKK = dataPenduduk.reduce((acc, r) => acc + (Number(r.kk) || 0), 0);

const daftarKeuangan = (typeof keuangan !== 'undefined' && Array.isArray(keuangan)) ? keuangan : [];
const totalDanaMasuk = daftarKeuangan.filter(k => k.tipe === 'masuk').reduce((sum, k) => sum + (Number(k.nominal) || 0), 0);
const totalDanaKeluar = daftarKeuangan.filter(k => k.tipe === 'keluar').reduce((sum, k) => sum + (Number(k.nominal) || 0), 0);
const saldoKasDesa = totalDanaMasuk - totalDanaKeluar;
const formatRp = n => 'Rp ' + Math.abs(Number(n) || 0).toLocaleString('id-ID');

const daftarBantuan = (typeof bantuanWarga !== 'undefined' && Array.isArray(bantuanWarga)) ? bantuanWarga : [];
const bantuanTersalurkan = daftarBantuan.filter(b => b.status === 'Tersalurkan').length;
const bantuanMenunggu = daftarBantuan.length - bantuanTersalurkan;
%>
<%- include('partials/head', { title: pageMeta.title + ' - Admin', bodyClass: 'page-muted admin-body' }) %>

<div class="admin-shell">
    <%- include('partials/admin-sidebar', {
        activeMenu: activeSection,
        counts: {
            berita: daftarBerita.length,
            galeri: daftarGaleri.length,
            laporan: daftarLaporan.length,
            suratMenunggu,
            bantuan: daftarBantuan.length
        }
    }) %>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-left">
                <button type="button" class="admin-menu-btn" data-admin-menu-toggle aria-label="Buka menu navigasi">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <span class="eyebrow">Panel Administrasi</span>
                    <h1><%= pageMeta.heading %></h1>
                    <p><%= pageMeta.sub %></p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/" class="btn btn-outline btn-sm">Lihat Situs <%- include('partials/icon', { name: 'arrow-right' }) %></a>
            </div>
        </header>

        <main id="konten" class="admin-content">
            <% if (error) { %>
                <div class="alert alert-error" role="alert"><%- include('partials/icon', { name: 'alert-circle' }) %> <%= error %></div>
            <% } %>
            <% if (success) { %>
                <!-- Notifikasi Toast Sukses (Simple & Non-intrusive) -->
                <div class="success-toast" id="success-toast" role="status" aria-live="polite">
                    <div class="success-toast-icon" aria-hidden="true">
                        <span class="success-toast-ring"></span>
                        <svg class="success-toast-svg" viewBox="0 0 36 36" fill="none">
                            <circle class="success-check-circle" cx="18" cy="18" r="16" stroke="currentColor" stroke-width="2.6"/>
                            <path class="success-check-mark" d="M11 18.5 15.8 23.2 25.2 13.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <div class="success-toast-body">
                        <strong>Berhasil</strong>
                        <p><%= success %></p>
                    </div>
                    <button type="button" class="success-toast-close" id="success-toast-close" aria-label="Tutup notifikasi">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                    <div class="success-toast-progress" aria-hidden="true"><span></span></div>
                </div>
            <% } %>
            <% if (activeSection === 'kelola-galeri' && isVercel && !hasVercelBlobConfig) { %>
                <div class="alert alert-warning" role="alert"><%- include('partials/icon', { name: 'alert-circle' }) %> Hubungkan Vercel Blob dengan akses publik ke project ini agar unggahan galeri dapat disimpan.</div>
            <% } %>

            <% if (activeSection === 'ringkasan') { %>
                <!-- HALAMAN 1: RINGKASAN -->
                <section class="admin-section">
                    <div class="dash-stats">
                        <a href="/admin/kependudukan" class="card stat-card stat-card-link">
                            <span class="icon-box"><%- include('partials/icon', { name: 'users' }) %></span>
                            <div><strong><%= totalPopulasi.toLocaleString('id-ID') %></strong><span>Total penduduk (<%= totalKK.toLocaleString('id-ID') %> KK)</span></div>
                        </a>
                        <a href="/admin/daftar-berita" class="card stat-card stat-card-link">
                            <span class="icon-box"><%- include('partials/icon', { name: 'news' }) %></span>
                            <div><strong><%= daftarBerita.length %></strong><span>Berita terbit</span></div>
                        </a>
                        <a href="/admin/laporan-warga" class="card stat-card stat-card-link">
                            <span class="icon-box"><%- include('partials/icon', { name: 'inbox' }) %></span>
                            <div><strong><%= daftarLaporan.length %></strong><span>Laporan warga</span></div>
                        </a>
                        <a href="/admin/surat-pengantar" class="card stat-card stat-card-link">
                            <span class="icon-box icon-box-accent"><%- include('partials/icon', { name: 'document' }) %></span>
                            <div><strong><%= suratMenunggu %></strong><span>Surat menunggu</span></div>
                        </a>
                    </div>

                    <!-- Aksi Cepat Menu Halaman -->
                    <div class="card mb-16">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'layers' }) %></span> Menu Kelola Cepat</h2>
                                <p class="card-subtitle">Pilih modul administrasi desa yang ingin Anda kelola.</p>
                            </div>
                        </div>
                        <div class="quick-grid">
                            <a href="/admin/kependudukan" class="card feature-card">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chart' }) %></span>
                                <div><h3>Grafik Kependudukan</h3><p>Hitung &amp; perbarui statistik penduduk per dusun.</p></div>
                            </a>
                            <a href="/admin/keuangan" class="card feature-card">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'wallet' }) %></span>
                                <div><h3>Dana Masuk &amp; Keluar</h3><p>Saldo kas: <strong><%= (saldoKasDesa < 0 ? '-' : '') + formatRp(saldoKasDesa) %></strong></p></div>
                            </a>
                            <a href="/admin/bantuan-desa" class="card feature-card">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'heart' }) %></span>
                                <div><h3>Penerima Bantuan (<%= daftarBantuan.length %>)</h3><p>Data warga yang membutuhkan bantuan desa.</p></div>
                            </a>
                            <a href="/admin/terbitkan-berita" class="card feature-card">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'megaphone' }) %></span>
                                <div><h3>Terbitkan Berita</h3><p>Tulis berita atau pengumuman baru untuk warga.</p></div>
                            </a>
                            <a href="/admin/kelola-galeri" class="card feature-card">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'image' }) %></span>
                                <div><h3>Kelola Galeri (<%= daftarGaleri.length %>)</h3><p>Unggah dokumentasi foto kegiatan desa.</p></div>
                            </a>
                            <a href="/admin/daftar-berita" class="card feature-card">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'news' }) %></span>
                                <div><h3>Daftar Berita (<%= daftarBerita.length %>)</h3><p>Edit atau hapus berita yang telah terbit.</p></div>
                            </a>
                        </div>
                    </div>

                    <!-- Aktivitas Terbaru (Preview 3 Surat & 3 Laporan) -->
                    <div class="dash-grid">
                        <section class="card">
                            <div class="card-header">
                                <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'document' }) %></span> Pengajuan Surat Terbaru</h2>
                                <a href="/admin/surat-pengantar" class="link-arrow">Kelola semua <span aria-hidden="true">→</span></a>
                            </div>
                            <% if (daftarSurat.length > 0) { %>
                                <div class="item-list">
                                    <% daftarSurat.slice(0, 3).forEach(function(surat) {
                                        const status = surat.status || 'Menunggu';
                                    %>
                                        <article class="item <%= status === 'Ditolak' ? 'is-danger' : 'is-secondary' %>">
                                            <div class="item-head">
                                                <span class="item-title"><%= surat.nama %> — <%= surat.keperluan %></span>
                                                <span class="badge <%= statusBadge(status) %>"><%= status %></span>
                                            </div>
                                            <div class="item-meta">
                                                <% if (surat.tanggal) { %><span><%= surat.tanggal %></span><% } %>
                                                <span><strong>NIK:</strong> <%= surat.nik %></span>
                                            </div>
                                        </article>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <p class="empty-text">Belum ada pengajuan surat pengantar.</p>
                            <% } %>
                        </section>

                        <section class="card">
                            <div class="card-header">
                                <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'inbox' }) %></span> Laporan Warga Terbaru</h2>
                                <a href="/admin/laporan-warga" class="link-arrow">Lihat semua <span aria-hidden="true">→</span></a>
                            </div>
                            <% if (daftarLaporan.length > 0) { %>
                                <div class="item-list">
                                    <% daftarLaporan.slice(0, 3).forEach(function(laporan) { %>
                                        <article class="item">
                                            <div class="item-head">
                                                <span class="item-title"><%= laporan.nama %></span>
                                                <span class="badge badge-primary"><%= laporan.tipe %></span>
                                            </div>
                                            <p><%= (laporan.isi || '').length > 90 ? laporan.isi.substring(0, 90) + '…' : laporan.isi %></p>
                                        </article>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <p class="empty-text">Belum ada laporan dari warga.</p>
                            <% } %>
                        </section>
                    </div>
                </section>
            <% } else if (activeSection === 'kependudukan') { %>
                <!-- HALAMAN 2: GRAFIK & HITUNG KEPENDUDUKAN OTOMATIS -->
                <section class="card admin-section pop-card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chart' }) %></span> Grafik &amp; Hitung Kependudukan Otomatis</h2>
                            <p class="card-subtitle">Ubah angka pada tabel di bawah — total jiwa, rasio, dan seluruh grafik dihitung otomatis secara langsung.</p>
                        </div>
                        <span class="badge badge-primary">Otomatis &amp; Real-time</span>
                    </div>

                    <div class="pop-summary-grid">
                        <div class="pop-metric">
                            <span class="pop-metric-label">Total Penduduk</span>
                            <strong class="pop-metric-value" id="pop-total-jiwa">0</strong>
                            <small class="pop-metric-sub"><span id="pop-dusun-count"><%= dataPenduduk.length %></span> wilayah dusun</small>
                        </div>
                        <div class="pop-metric">
                            <span class="pop-metric-label">Laki-laki</span>
                            <strong class="pop-metric-value is-male" id="pop-total-laki">0</strong>
                            <small class="pop-metric-sub"><span id="pop-pct-laki">0%</span> dari populasi</small>
                        </div>
                        <div class="pop-metric">
                            <span class="pop-metric-label">Perempuan</span>
                            <strong class="pop-metric-value is-female" id="pop-total-perempuan">0</strong>
                            <small class="pop-metric-sub"><span id="pop-pct-perempuan">0%</span> dari populasi</small>
                        </div>
                        <div class="pop-metric">
                            <span class="pop-metric-label">Kepala Keluarga (KK)</span>
                            <strong class="pop-metric-value" id="pop-total-kk">0</strong>
                            <small class="pop-metric-sub">Rata-rata <span id="pop-avg-kk">0</span> jiwa/KK</small>
                        </div>
                    </div>

                    <div class="pop-charts-grid">
                        <div class="pop-chart-box">
                            <div class="pop-chart-head">
                                <h3>Distribusi Penduduk per Dusun</h3>
                                <div class="pop-legend-inline">
                                    <span><i class="pop-dot is-male"></i> Laki-laki</span>
                                    <span><i class="pop-dot is-female"></i> Perempuan</span>
                                </div>
                            </div>
                            <div class="pop-dusun-bars" id="pop-dusun-bars"></div>
                        </div>

                        <div class="pop-chart-box">
                            <div class="pop-chart-head">
                                <h3>Komposisi Jenis Kelamin</h3>
                                <span class="badge" id="pop-sex-ratio">Rasio 100</span>
                            </div>
                            <div class="pop-donut-wrap">
                                <div class="pop-donut" id="pop-gender-donut">
                                    <div class="pop-donut-hole">
                                        <strong id="pop-donut-total">0</strong>
                                        <span>Total Jiwa</span>
                                    </div>
                                </div>
                                <div class="pop-donut-legend">
                                    <div class="pop-legend-row">
                                        <span class="pop-legend-name"><i class="pop-dot is-male"></i> Laki-laki</span>
                                        <strong id="pop-legend-laki">0 (0%)</strong>
                                    </div>
                                    <div class="pop-legend-row">
                                        <span class="pop-legend-name"><i class="pop-dot is-female"></i> Perempuan</span>
                                        <strong id="pop-legend-perempuan">0 (0%)</strong>
                                    </div>
                                    <div class="pop-legend-row is-total">
                                        <span class="pop-legend-name">Selisih</span>
                                        <strong id="pop-legend-diff">0 jiwa</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pop-chart-box">
                            <div class="pop-chart-head">
                                <h3>Kelompok Usia Penduduk</h3>
                                <span class="badge badge-primary" id="pop-age-total-badge">0 jiwa</span>
                            </div>
                            <div class="pop-age-bars" id="pop-age-bars"></div>
                        </div>
                    </div>

                    <form action="/admin/kependudukan" method="POST" id="pop-calc-form" class="pop-form">
                        <div class="pop-table-head">
                            <div>
                                <h3>Kalkulator Data Kependudukan per Dusun</h3>
                                <p>Ketik perubahan angka di bawah untuk menghitung ulang grafik secara otomatis, lalu klik <strong>Simpan Data</strong>.</p>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <%- include('partials/icon', { name: 'check-circle' }) %>
                                <span>Simpan Data Kependudukan</span>
                            </button>
                        </div>

                        <div class="pop-table-wrap">
                            <table class="pop-table">
                                <thead>
                                    <tr>
                                        <th>Wilayah Dusun</th>
                                        <th>Laki-laki</th>
                                        <th>Perempuan</th>
                                        <th>Jumlah KK</th>
                                        <th>Balita<br><small>(0–5 th)</small></th>
                                        <th>Anak &amp; Remaja<br><small>(6–17 th)</small></th>
                                        <th>Dewasa<br><small>(18–59 th)</small></th>
                                        <th>Lansia<br><small>(60+ th)</small></th>
                                        <th>Total Jiwa<br><small>(Otomatis)</small></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% dataPenduduk.forEach(function(row, idx) { %>
                                        <tr data-pop-row="<%= idx %>">
                                            <td>
                                                <strong class="pop-dusun-name"><%= row.dusun %></strong>
                                                <input type="hidden" name="dusun" value="<%= row.dusun %>">
                                            </td>
                                            <td><input type="number" min="0" name="laki_laki" value="<%= row.laki_laki %>" class="pop-input" data-field="laki" aria-label="Laki-laki <%= row.dusun %>"></td>
                                            <td><input type="number" min="0" name="perempuan" value="<%= row.perempuan %>" class="pop-input" data-field="perempuan" aria-label="Perempuan <%= row.dusun %>"></td>
                                            <td><input type="number" min="0" name="kk" value="<%= row.kk %>" class="pop-input" data-field="kk" aria-label="KK <%= row.dusun %>"></td>
                                            <td><input type="number" min="0" name="balita" value="<%= row.balita %>" class="pop-input" data-field="balita" aria-label="Balita <%= row.dusun %>"></td>
                                            <td><input type="number" min="0" name="anak_remaja" value="<%= row.anak_remaja %>" class="pop-input" data-field="remaja" aria-label="Anak & Remaja <%= row.dusun %>"></td>
                                            <td><input type="number" min="0" name="dewasa" value="<%= row.dewasa %>" class="pop-input" data-field="dewasa" aria-label="Dewasa <%= row.dusun %>"></td>
                                            <td><input type="number" min="0" name="lansia" value="<%= row.lansia %>" class="pop-input" data-field="lansia" aria-label="Lansia <%= row.dusun %>"></td>
                                            <td class="pop-row-total"><strong data-row-total>0</strong><span>jiwa</span></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>Total Desa</th>
                                        <th id="tfoot-laki">0</th>
                                        <th id="tfoot-perempuan">0</th>
                                        <th id="tfoot-kk">0</th>
                                        <th id="tfoot-balita">0</th>
                                        <th id="tfoot-remaja">0</th>
                                        <th id="tfoot-dewasa">0</th>
                                        <th id="tfoot-lansia">0</th>
                                        <th id="tfoot-total">0</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </form>
                </section>
            <% } else if (activeSection === 'keuangan') { %>
                <!-- HALAMAN KEUANGAN: MANAJEMEN DANA MASUK & KELUAR -->
                <%
                    const totalArusKas = totalDanaMasuk + totalDanaKeluar;
                    const pctMasukNum = totalArusKas > 0 ? ((totalDanaMasuk / totalArusKas) * 100) : 50;
                    const pctKeluarNum = totalArusKas > 0 ? ((totalDanaKeluar / totalArusKas) * 100) : 50;
                    const pctMasuk = pctMasukNum.toFixed(1);
                    const pctKeluar = pctKeluarNum.toFixed(1);
                    const degMasuk = totalArusKas > 0 ? ((totalDanaMasuk / totalArusKas) * 360).toFixed(1) : 180;
                    const serapanPct = totalDanaMasuk > 0 ? Math.min(100, (totalDanaKeluar / totalDanaMasuk) * 100).toFixed(1) : '0.0';
                    const countMasuk = daftarKeuangan.filter(k => k.tipe === 'masuk').length;
                    const countKeluar = daftarKeuangan.filter(k => k.tipe === 'keluar').length;
                    const tanggalDefault = new Date().toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric'
                    });

                    // Agregasi per kategori untuk grafik batang
                    const mapMasuk = {};
                    const mapKeluar = {};
                    daftarKeuangan.forEach(item => {
                        const nom = Number(item.nominal) || 0;
                        const kat = item.kategori || 'Lainnya';
                        if (item.tipe === 'masuk') {
                            mapMasuk[kat] = (mapMasuk[kat] || 0) + nom;
                        } else {
                            mapKeluar[kat] = (mapKeluar[kat] || 0) + nom;
                        }
                    });
                    const listKategoriMasuk = Object.entries(mapMasuk).sort((a, b) => b[1] - a[1]);
                    const listKategoriKeluar = Object.entries(mapKeluar).sort((a, b) => b[1] - a[1]);
                %>
                <section class="admin-section stack">
                    <!-- 3 Kartu Metrik Keuangan (Sejajar Rapi) -->
                    <div class="fin-summary-grid">
                        <div class="card fin-stat-card is-income">
                            <div class="fin-stat-head">
                                <span class="fin-stat-label">Total Dana Masuk</span>
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'trend-up' }) %></span>
                            </div>
                            <strong class="fin-stat-value"><%= formatRp(totalDanaMasuk) %></strong>
                            <small class="fin-stat-sub"><%= countMasuk %> transaksi pemasukan</small>
                        </div>

                        <div class="card fin-stat-card is-expense">
                            <div class="fin-stat-head">
                                <span class="fin-stat-label">Total Dana Keluar</span>
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'trend-down' }) %></span>
                            </div>
                            <strong class="fin-stat-value"><%= formatRp(totalDanaKeluar) %></strong>
                            <small class="fin-stat-sub"><%= countKeluar %> transaksi pengeluaran</small>
                        </div>

                        <div class="card fin-stat-card is-balance">
                            <div class="fin-stat-head">
                                <span class="fin-stat-label">Saldo Kas Desa Saat Ini</span>
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'wallet' }) %></span>
                            </div>
                            <strong class="fin-stat-value <%= saldoKasDesa < 0 ? 'is-negative' : '' %>">
                                <%= (saldoKasDesa < 0 ? '- ' : '') + formatRp(saldoKasDesa) %>
                            </strong>
                            <small class="fin-stat-sub">Serapan anggaran: <strong><%= serapanPct.replace('.', ',') %>%</strong></small>
                        </div>
                    </div>

                    <!-- 3 Grafik Visual Keuangan Desa -->
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">
                                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chart' }) %></span>
                                    Grafik Visualisasi Dana Masuk &amp; Keluar
                                </h2>
                                <p class="card-subtitle">Proporsi arus kas, sumber pemasukan, dan realisasi pengeluaran berdasarkan kategori.</p>
                            </div>
                            <span class="badge badge-primary"><%= daftarKeuangan.length %> transaksi tercatat</span>
                        </div>

                        <div class="pop-charts-grid mb-0">
                            <!-- Grafik 1: Donut Proporsi Arus Kas -->
                            <div class="pop-chart-box">
                                <div class="pop-chart-head">
                                    <h3>Komposisi Arus Kas</h3>
                                    <span class="badge <%= saldoKasDesa >= 0 ? 'badge-success' : 'badge-danger' %>">
                                        <%= saldoKasDesa >= 0 ? 'Surplus' : 'Defisit' %>
                                    </span>
                                </div>
                                <div class="pop-donut-wrap">
                                    <div class="pop-donut" data-donut-deg="<%= degMasuk %>">
                                        <div class="pop-donut-hole">
                                            <strong><%= serapanPct.replace('.', ',') %>%</strong>
                                            <span>Serapan</span>
                                        </div>
                                    </div>
                                    <div class="pop-donut-legend">
                                        <div class="pop-legend-row">
                                            <span class="pop-legend-name"><i class="pop-dot is-male"></i> Masuk</span>
                                            <strong><%= pctMasuk.replace('.', ',') %>%</strong>
                                        </div>
                                        <div class="pop-legend-row">
                                            <span class="pop-legend-name"><i class="pop-dot is-danger-dot"></i> Keluar</span>
                                            <strong><%= pctKeluar.replace('.', ',') %>%</strong>
                                        </div>
                                        <div class="pop-legend-row is-total">
                                            <span class="pop-legend-name">Total Arus</span>
                                            <strong><%= formatRp(totalArusKas) %></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Grafik 2: Batang Sumber Dana Masuk per Kategori -->
                            <div class="pop-chart-box">
                                <div class="pop-chart-head">
                                    <h3>Grafik Sumber Dana Masuk</h3>
                                    <span class="badge badge-success"><%= listKategoriMasuk.length %> sumber</span>
                                </div>
                                <% if (listKategoriMasuk.length > 0) { %>
                                    <div class="pop-age-bars">
                                        <% listKategoriMasuk.forEach(function(entry) {
                                            const kat = entry[0];
                                            const nilai = entry[1];
                                            const pct = totalDanaMasuk > 0 ? ((nilai / totalDanaMasuk) * 100) : 0;
                                        %>
                                            <div class="pop-age-item">
                                                <div class="pop-age-meta">
                                                    <span><%= kat %></span>
                                                    <strong><%= formatRp(nilai) %> <small>(<%= pct.toFixed(1).replace('.', ',') %>%)</small></strong>
                                                </div>
                                                <div class="pop-bar-track">
                                                    <span class="pop-bar-fill is-male" data-bar-width="<%= pct.toFixed(1) %>"></span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="empty-text">Belum ada data pemasukan untuk ditampilkan pada grafik.</p>
                                <% } %>
                            </div>

                            <!-- Grafik 3: Batang Alokasi Dana Keluar per Kategori -->
                            <div class="pop-chart-box">
                                <div class="pop-chart-head">
                                    <h3>Grafik Alokasi Dana Keluar</h3>
                                    <span class="badge badge-danger"><%= listKategoriKeluar.length %> bidang</span>
                                </div>
                                <% if (listKategoriKeluar.length > 0) { %>
                                    <div class="pop-age-bars">
                                        <% listKategoriKeluar.forEach(function(entry) {
                                            const kat = entry[0];
                                            const nilai = entry[1];
                                            const pct = totalDanaKeluar > 0 ? ((nilai / totalDanaKeluar) * 100) : 0;
                                        %>
                                            <div class="pop-age-item">
                                                <div class="pop-age-meta">
                                                    <span><%= kat %></span>
                                                    <strong><%= formatRp(nilai) %> <small>(<%= pct.toFixed(1).replace('.', ',') %>%)</small></strong>
                                                </div>
                                                <div class="pop-bar-track">
                                                    <span class="pop-bar-fill is-danger-fill" data-bar-width="<%= pct.toFixed(1) %>"></span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="empty-text">Belum ada data pengeluaran untuk ditampilkan pada grafik.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Layout 2 Kolom: Form Input Transaksi & Buku Kas Riwayat -->
                    <div class="fin-main-layout">
                        <!-- Form Catat Transaksi -->
                        <section class="card">
                            <div class="card-header">
                                <div>
                                    <h2 class="card-title">
                                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'wallet' }) %></span>
                                        Catat Transaksi Dana
                                    </h2>
                                    <p class="card-subtitle">Tambahkan catatan dana masuk atau pengeluaran desa.</p>
                                </div>
                            </div>

                            <form action="/admin/keuangan/tambah" method="POST" id="fin-form">
                                <div class="form-group">
                                    <label>Jenis Transaksi</label>
                                    <div class="fin-type-switch">
                                        <label class="fin-type-option">
                                            <input type="radio" name="tipe" value="masuk" checked>
                                            <span class="fin-type-pill is-income">
                                                <%- include('partials/icon', { name: 'trend-up' }) %>
                                                Dana Masuk
                                            </span>
                                        </label>
                                        <label class="fin-type-option">
                                            <input type="radio" name="tipe" value="keluar">
                                            <span class="fin-type-pill is-expense">
                                                <%- include('partials/icon', { name: 'trend-down' }) %>
                                                Dana Keluar
                                            </span>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="fin-kategori">Sumber / Kategori Dana</label>
                                    <select id="fin-kategori" name="kategori" required>
                                        <optgroup label="Kategori Dana Masuk" id="opt-masuk">
                                            <option value="Dana Desa (APBN)">Dana Desa (APBN)</option>
                                            <option value="Alokasi Dana Desa (ADD)">Alokasi Dana Desa (ADD)</option>
                                            <option value="Pendapatan Asli Desa (PADes)">Pendapatan Asli Desa (PADes)</option>
                                            <option value="Bantuan Provinsi / Kabupaten">Bantuan Provinsi / Kabupaten</option>
                                            <option value="Swadaya & Hibah Masyarakat">Swadaya &amp; Hibah Masyarakat</option>
                                        </optgroup>
                                        <optgroup label="Kategori Dana Keluar" id="opt-keluar">
                                            <option value="Pembangunan Infrastruktur">Pembangunan Infrastruktur</option>
                                            <option value="Pemberdayaan Masyarakat">Pemberdayaan Masyarakat</option>
                                            <option value="Bantuan Sosial & Kesehatan">Bantuan Sosial &amp; Kesehatan</option>
                                            <option value="Operasional Pemerintahan">Operasional Pemerintahan</option>
                                            <option value="Kegiatan Kemasyarakatan">Kegiatan Kemasyarakatan</option>
                                        </optgroup>
                                        <option value="Lainnya">Lainnya</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="fin-nominal-display">Nominal (Rp)</label>
                                    <div class="fin-currency-wrap">
                                        <span class="fin-currency-prefix">Rp</span>
                                        <input id="fin-nominal-display" type="text" name="nominal_display" inputmode="numeric" required placeholder="Contoh: 25.000.000" autocomplete="off">
                                        <input id="fin-nominal" type="hidden" name="nominal" value="">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="fin-tanggal">Tanggal Transaksi</label>
                                    <input id="fin-tanggal" type="text" name="tanggal" value="<%= tanggalDefault %>" required placeholder="Contoh: 19 November 2026">
                                </div>

                                <div class="form-group">
                                    <label for="fin-keterangan">Rincian / Keterangan</label>
                                    <textarea id="fin-keterangan" name="keterangan" rows="3" required placeholder="Contoh: Pencairan tahap I pembangunan drainase Dusun Karang..."></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary btn-block">
                                    <%- include('partials/icon', { name: 'check-circle' }) %>
                                    <span>Simpan Transaksi</span>
                                </button>
                            </form>
                        </section>

                        <!-- Tabel Buku Kas / Riwayat Transaksi -->
                        <section class="card">
                            <div class="card-header">
                                <div>
                                    <h2 class="card-title">
                                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'clipboard' }) %></span>
                                        Buku Kas Riwayat Dana
                                    </h2>
                                    <p class="card-subtitle">Filter dan kelola seluruh riwayat transaksi dana masuk &amp; keluar.</p>
                                </div>
                                <div class="fin-filter-tabs" role="tablist" aria-label="Filter transaksi">
                                    <button type="button" class="fin-filter-btn is-active" data-fin-filter="all">Semua (<%= daftarKeuangan.length %>)</button>
                                    <button type="button" class="fin-filter-btn" data-fin-filter="masuk">Masuk (<%= countMasuk %>)</button>
                                    <button type="button" class="fin-filter-btn" data-fin-filter="keluar">Keluar (<%= countKeluar %>)</button>
                                </div>
                            </div>

                            <% if (daftarKeuangan.length > 0) { %>
                                <div class="pop-table-wrap table-responsive-cards">
                                    <table class="pop-table fin-table" id="fin-ledger-table">
                                        <thead>
                                            <tr>
                                                <th>Tanggal &amp; Kategori</th>
                                                <th>Rincian Keterangan</th>
                                                <th>Jenis</th>
                                                <th>Nominal</th>
                                                <th style="width: 90px; text-align: right;">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% daftarKeuangan.forEach(function(item) {
                                                const isMasuk = item.tipe === 'masuk';
                                            %>
                                                <tr data-fin-row="<%= item.tipe %>">
                                                    <td data-label="Kategori">
                                                        <div>
                                                            <strong class="fin-row-cat"><%= item.kategori %></strong>
                                                            <small class="fin-row-date"><%= item.tanggal %></small>
                                                        </div>
                                                    </td>
                                                    <td data-label="Rincian"><span><%= item.keterangan %></span></td>
                                                    <td data-label="Jenis">
                                                        <span class="badge <%= isMasuk ? 'badge-success' : 'badge-danger' %>">
                                                            <%= isMasuk ? 'Dana Masuk' : 'Dana Keluar' %>
                                                        </span>
                                                    </td>
                                                    <td data-label="Nominal" class="fin-amount <%= isMasuk ? 'is-income' : 'is-expense' %>">
                                                        <span><%= (isMasuk ? '+ ' : '- ') + formatRp(item.nominal) %></span>
                                                    </td>
                                                    <td data-label="Aksi" style="text-align: right;">
                                                        <form action="/admin/keuangan/<%= item.id %>/hapus" method="POST" data-confirm-title="Hapus Catatan Transaksi?" data-confirm="Apakah Anda yakin ingin menghapus catatan transaksi &quot;<%= item.kategori %>&quot; sebesar <%= formatRp(item.nominal) %>?" style="margin: 0;">
                                                            <button type="submit" class="btn btn-danger-soft btn-sm" aria-label="Hapus transaksi">
                                                                <%- include('partials/icon', { name: 'trash' }) %>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <span class="icon-box"><%- include('partials/icon', { name: 'wallet' }) %></span>
                                    <h3>Belum ada catatan dana</h3>
                                    <p>Gunakan formulir di sebelah kiri untuk mencatat pemasukan atau pengeluaran dana desa pertama Anda.</p>
                                </div>
                            <% } %>
                        </section>
                    </div>
                </section>
            <% } else if (activeSection === 'bantuan-desa') { %>
                <!-- HALAMAN PENERIMA BANTUAN DESA -->
                <%
                    const totalNilaiBantuan = daftarBantuan.reduce((sum, b) => sum + (Number(b.nominal) || 0), 0);
                    const totalBantuanCount = daftarBantuan.length;
                    const pctSalurNum = totalBantuanCount > 0 ? ((bantuanTersalurkan / totalBantuanCount) * 100) : 0;
                    const pctMenungguNum = totalBantuanCount > 0 ? ((bantuanMenunggu / totalBantuanCount) * 100) : 0;
                    const degSalur = totalBantuanCount > 0 ? ((bantuanTersalurkan / totalBantuanCount) * 360).toFixed(1) : 0;

                    // Agregasi per kriteria kebutuhan & per dusun
                    const mapKriteria = {};
                    const mapDusunBantuan = {};
                    daftarBantuan.forEach(b => {
                        const krit = b.kriteria || 'Lainnya';
                        const dsn = b.dusun || 'Lainnya';
                        mapKriteria[krit] = (mapKriteria[krit] || 0) + 1;
                        mapDusunBantuan[dsn] = (mapDusunBantuan[dsn] || 0) + 1;
                    });
                    const listKriteria = Object.entries(mapKriteria).sort((a, b) => b[1] - a[1]);
                    const listDusunBantuan = Object.entries(mapDusunBantuan).sort((a, b) => b[1] - a[1]);
                %>
                <section class="admin-section stack">
                    <!-- 4 Kartu Metrik Bantuan Sosial -->
                    <div class="pop-summary-grid mb-0">
                        <div class="card stat-card">
                            <span class="icon-box"><%- include('partials/icon', { name: 'heart' }) %></span>
                            <div>
                                <strong><%= totalBantuanCount.toLocaleString('id-ID') %> Warga</strong>
                                <span>Total Penerima Terdata</span>
                            </div>
                        </div>
                        <div class="card stat-card">
                            <span class="icon-box icon-box-success"><%- include('partials/icon', { name: 'check-circle' }) %></span>
                            <div>
                                <strong><%= bantuanTersalurkan.toLocaleString('id-ID') %> Warga</strong>
                                <span>Sudah Tersalurkan (<%= pctSalurNum.toFixed(0) %>%)</span>
                            </div>
                        </div>
                        <div class="card stat-card">
                            <span class="icon-box icon-box-accent"><%- include('partials/icon', { name: 'alert-circle' }) %></span>
                            <div>
                                <strong><%= bantuanMenunggu.toLocaleString('id-ID') %> Warga</strong>
                                <span>Belum Tersalurkan</span>
                            </div>
                        </div>
                        <div class="card stat-card">
                            <span class="icon-box"><%- include('partials/icon', { name: 'wallet' }) %></span>
                            <div>
                                <strong><%= formatRp(totalNilaiBantuan) %></strong>
                                <span>Total Nilai Bantuan</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3 Grafik Distribusi Penerima Bantuan -->
                    <div class="card">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">
                                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chart' }) %></span>
                                    Grafik Distribusi Warga Penerima Bantuan
                                </h2>
                                <p class="card-subtitle">Proporsi realisasi penyaluran, kategori kerentanan warga, dan sebaran wilayah dusun.</p>
                            </div>
                            <span class="badge badge-primary"><%= totalBantuanCount %> keluarga/warga</span>
                        </div>

                        <div class="pop-charts-grid mb-0">
                            <!-- Grafik 1: Donut Status Penyaluran -->
                            <div class="pop-chart-box">
                                <div class="pop-chart-head">
                                    <h3>Realisasi Penyaluran</h3>
                                    <span class="badge badge-success"><%= pctSalurNum.toFixed(0) %>% selesai</span>
                                </div>
                                <div class="pop-donut-wrap">
                                    <div class="pop-donut" data-aid-donut-deg="<%= degSalur %>">
                                        <div class="pop-donut-hole">
                                            <strong><%= totalBantuanCount %></strong>
                                            <span>Penerima</span>
                                        </div>
                                    </div>
                                    <div class="pop-donut-legend">
                                        <div class="pop-legend-row">
                                            <span class="pop-legend-name"><i class="pop-dot is-male"></i> Tersalurkan</span>
                                            <strong><%= bantuanTersalurkan %> (<%= pctSalurNum.toFixed(1).replace('.', ',') %>%)</strong>
                                        </div>
                                        <div class="pop-legend-row">
                                            <span class="pop-legend-name"><i class="pop-dot is-female"></i> Menunggu</span>
                                            <strong><%= bantuanMenunggu %> (<%= pctMenungguNum.toFixed(1).replace('.', ',') %>%)</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Grafik 2: Batang Kriteria Warga Membutuhkan -->
                            <div class="pop-chart-box">
                                <div class="pop-chart-head">
                                    <h3>Berdasarkan Kriteria Warga</h3>
                                    <span class="badge badge-primary"><%= listKriteria.length %> kriteria</span>
                                </div>
                                <% if (listKriteria.length > 0) { %>
                                    <div class="pop-age-bars">
                                        <% listKriteria.forEach(function(entry) {
                                            const label = entry[0];
                                            const count = entry[1];
                                            const pct = totalBantuanCount > 0 ? ((count / totalBantuanCount) * 100) : 0;
                                        %>
                                            <div class="pop-age-item">
                                                <div class="pop-age-meta">
                                                    <span><%= label %></span>
                                                    <strong><%= count %> warga <small>(<%= pct.toFixed(1).replace('.', ',') %>%)</small></strong>
                                                </div>
                                                <div class="pop-bar-track">
                                                    <span class="pop-bar-fill is-male" data-bar-width="<%= pct.toFixed(1) %>"></span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="empty-text">Belum ada data kriteria penerima bantuan.</p>
                                <% } %>
                            </div>

                            <!-- Grafik 3: Batang Sebaran per Dusun -->
                            <div class="pop-chart-box">
                                <div class="pop-chart-head">
                                    <h3>Sebaran per Wilayah Dusun</h3>
                                    <span class="badge"><%= listDusunBantuan.length %> dusun</span>
                                </div>
                                <% if (listDusunBantuan.length > 0) { %>
                                    <div class="pop-age-bars">
                                        <% listDusunBantuan.forEach(function(entry) {
                                            const label = entry[0];
                                            const count = entry[1];
                                            const pct = totalBantuanCount > 0 ? ((count / totalBantuanCount) * 100) : 0;
                                        %>
                                            <div class="pop-age-item">
                                                <div class="pop-age-meta">
                                                    <span><%= label %></span>
                                                    <strong><%= count %> warga <small>(<%= pct.toFixed(1).replace('.', ',') %>%)</small></strong>
                                                </div>
                                                <div class="pop-bar-track">
                                                    <span class="pop-bar-fill is-female" data-bar-width="<%= pct.toFixed(1) %>"></span>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <p class="empty-text">Belum ada data sebaran dusun.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Layout 2 Kolom: Form Tambah Warga Membutuhkan & Tabel Daftar Penerima -->
                    <div class="fin-main-layout">
                        <!-- Form Pendataan Warga Membutuhkan -->
                        <section class="card">
                            <div class="card-header">
                                <div>
                                    <h2 class="card-title">
                                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'heart' }) %></span>
                                        Tambah Warga Penerima
                                    </h2>
                                    <p class="card-subtitle">Daftarkan warga yang membutuhkan bantuan desa.</p>
                                </div>
                            </div>

                            <form action="/admin/bantuan/tambah" method="POST" id="aid-form">
                                <div class="form-group">
                                    <label for="aid-nama">Nama Lengkap Warga</label>
                                    <input id="aid-nama" type="text" name="nama" required placeholder="Contoh: Ibu Siti Aminah">
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="aid-nik">NIK</label>
                                        <input id="aid-nik" type="text" name="nik" inputmode="numeric" maxlength="20" required placeholder="16 digit NIK">
                                    </div>
                                    <div class="form-group">
                                        <label for="aid-dusun">Wilayah Dusun</label>
                                        <select id="aid-dusun" name="dusun" required>
                                            <% dataPenduduk.forEach(function(d) { %>
                                                <option value="<%= d.dusun %>"><%= d.dusun %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="aid-kriteria">Kriteria / Kondisi Kelayakan</label>
                                    <select id="aid-kriteria" name="kriteria" required>
                                        <option value="Keluarga Kurang Mampu (DTKS)">Keluarga Kurang Mampu (DTKS)</option>
                                        <option value="Lansia Tunggal / Rentan">Lansia Tunggal / Rentan</option>
                                        <option value="Penyandang Disabilitas">Penyandang Disabilitas</option>
                                        <option value="Anak Yatim / Piatu">Anak Yatim / Piatu</option>
                                        <option value="Ibu Hamil / Balita Stunting">Ibu Hamil / Balita Stunting</option>
                                        <option value="Korban Bencana / Musibah">Korban Bencana / Musibah</option>
                                        <option value="Buruh Tani / Pekerja Harian">Buruh Tani / Pekerja Harian</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="aid-jenis">Program / Jenis Bantuan</label>
                                    <select id="aid-jenis" name="jenis_bantuan" required>
                                        <option value="BLT Dana Desa">BLT Dana Desa</option>
                                        <option value="Bantuan Sembako Pangan">Bantuan Sembako Pangan</option>
                                        <option value="Program Keluarga Harapan (PKH)">Program Keluarga Harapan (PKH)</option>
                                        <option value="Bantuan Rehab Rumah (RTLH)">Bantuan Rehab Rumah (RTLH)</option>
                                        <option value="Bantuan Gizi & Kesehatan">Bantuan Gizi &amp; Kesehatan</option>
                                        <option value="Bantuan Modal Usaha Mikro">Bantuan Modal Usaha Mikro</option>
                                    </select>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="aid-nominal-display">Nilai Bantuan (Rp)</label>
                                        <div class="fin-currency-wrap">
                                            <span class="fin-currency-prefix">Rp</span>
                                            <input id="aid-nominal-display" type="text" name="nominal_display" inputmode="numeric" required placeholder="300.000" autocomplete="off">
                                            <input id="aid-nominal" type="hidden" name="nominal" value="">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="aid-status">Status Awal</label>
                                        <select id="aid-status" name="status">
                                            <option value="Belum Tersalurkan">Belum Tersalurkan</option>
                                            <option value="Tersalurkan">Sudah Tersalurkan</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="aid-catatan">Catatan Kondisi Warga <span class="optional">(opsional)</span></label>
                                    <textarea id="aid-catatan" name="catatan" rows="2" placeholder="Contoh: Tinggal seorang diri, rumah perlu perbaikan atap..."></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary btn-block">
                                    <%- include('partials/icon', { name: 'check-circle' }) %>
                                    <span>Simpan Data Penerima</span>
                                </button>
                            </form>
                        </section>

                        <!-- Daftar Warga Penerima Bantuan -->
                        <section class="card">
                            <div class="card-header">
                                <div>
                                    <h2 class="card-title">
                                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'users' }) %></span>
                                        Daftar Warga Penerima Bantuan
                                    </h2>
                                    <p class="card-subtitle">Pantau dan perbarui status penyaluran bantuan kepada warga.</p>
                                </div>
                                <div class="fin-filter-tabs" role="tablist" aria-label="Filter status bantuan">
                                    <button type="button" class="fin-filter-btn is-active" data-aid-filter="all">Semua (<%= totalBantuanCount %>)</button>
                                    <button type="button" class="fin-filter-btn" data-aid-filter="Belum Tersalurkan">Menunggu (<%= bantuanMenunggu %>)</button>
                                    <button type="button" class="fin-filter-btn" data-aid-filter="Tersalurkan">Tersalurkan (<%= bantuanTersalurkan %>)</button>
                                </div>
                            </div>

                            <% if (daftarBantuan.length > 0) { %>
                                <div class="pop-table-wrap table-responsive-cards">
                                    <table class="pop-table fin-table" id="aid-table">
                                        <thead>
                                            <tr>
                                                <th>Data Warga</th>
                                                <th>Kriteria &amp; Program</th>
                                                <th>Nilai Bantuan</th>
                                                <th>Status</th>
                                                <th style="width: 190px; text-align: right;">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% daftarBantuan.forEach(function(item) {
                                                const isSalur = item.status === 'Tersalurkan';
                                            %>
                                                <tr data-aid-row="<%= item.status %>">
                                                    <td data-label="Data Warga">
                                                        <div>
                                                            <strong class="fin-row-cat"><%= item.nama %></strong>
                                                            <small class="fin-row-date">NIK: <%= item.nik %> · <strong><%= item.dusun %></strong></small>
                                                            <% if (item.catatan) { %>
                                                                <small class="aid-row-note">“<%= item.catatan %>”</small>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td data-label="Program">
                                                        <div>
                                                            <strong class="fin-row-cat"><%= item.jenis_bantuan %></strong>
                                                            <small class="fin-row-date"><%= item.kriteria %></small>
                                                        </div>
                                                    </td>
                                                    <td data-label="Nilai Bantuan" class="fin-amount is-income">
                                                        <div>
                                                            <%= formatRp(item.nominal) %>
                                                            <small class="fin-row-date"><%= item.tanggal %></small>
                                                        </div>
                                                    </td>
                                                    <td data-label="Status">
                                                        <span class="badge <%= isSalur ? 'badge-success' : 'badge-warning' %>">
                                                            <%= item.status %>
                                                        </span>
                                                    </td>
                                                    <td data-label="Aksi" style="text-align: right;">
                                                        <div class="aid-row-actions">
                                                            <form action="/admin/bantuan/<%= item.id %>/status" method="POST" style="margin: 0;">
                                                                <input type="hidden" name="status" value="<%= isSalur ? 'Belum Tersalurkan' : 'Tersalurkan' %>">
                                                                <button type="submit" class="btn <%= isSalur ? 'btn-outline' : 'btn-primary' %> btn-sm">
                                                                    <% if (!isSalur) { %><%- include('partials/icon', { name: 'check-circle' }) %><% } %>
                                                                    <span><%= isSalur ? 'Batalkan' : 'Salurkan' %></span>
                                                                </button>
                                                            </form>
                                                            <form action="/admin/bantuan/<%= item.id %>/hapus" method="POST" data-confirm-title="Hapus Data Penerima Bantuan?" data-confirm="Apakah Anda yakin ingin menghapus data penerima bantuan atas nama &quot;<%= item.nama %>&quot; (<%= item.jenis_bantuan %>)?" style="margin: 0;">
                                                                <button type="submit" class="btn btn-danger-soft btn-sm" aria-label="Hapus penerima">
                                                                    <%- include('partials/icon', { name: 'trash' }) %>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <span class="icon-box"><%- include('partials/icon', { name: 'heart' }) %></span>
                                    <h3>Belum ada data warga penerima bantuan</h3>
                                    <p>Silakan tambahkan data warga yang membutuhkan bantuan menggunakan formulir di sebelah kiri.</p>
                                </div>
                            <% } %>
                        </section>
                    </div>
                </section>
            <% } else if (activeSection === 'terbitkan-berita') { %>
                <!-- HALAMAN 3: TERBITKAN BERITA -->
                <%
                    const tanggalHariIni = new Date().toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric'
                    });
                %>
                <div class="publish-layout admin-section">
                    <!-- Kolom Kiri: Editor Berita -->
                    <section class="card publish-editor-card">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">
                                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'megaphone' }) %></span>
                                    Tulis Berita &amp; Pengumuman
                                </h2>
                                <p class="card-subtitle">Lengkapi detail berita di bawah. Pratinjau di sebelah kanan menyesuaikan otomatis.</p>
                            </div>
                            <a href="/admin/daftar-berita" class="btn btn-outline btn-sm">
                                <%- include('partials/icon', { name: 'news' }) %>
                                <span>Daftar Berita (<%= daftarBerita.length %>)</span>
                            </a>
                        </div>

                        <form action="/admin/tambah-berita" method="POST" enctype="multipart/form-data" id="publish-news-form">
                            <div class="form-group">
                                <div class="publish-label-row">
                                    <label for="berita-judul">Judul Berita</label>
                                    <small class="publish-counter"><span id="judul-count">0</span>/150 karakter</small>
                                </div>
                                <input id="berita-judul" type="text" name="judul" maxlength="150" required placeholder="Contoh: Jadwal Musyawarah Perencanaan Pembangunan Desa">
                            </div>

                            <div class="form-group">
                                <div class="publish-label-row">
                                    <label for="berita-ringkasan">Isi Berita / Informasi</label>
                                    <small class="publish-counter"><span id="isi-count">0</span> karakter</small>
                                </div>
                                <textarea id="berita-ringkasan" name="ringkasan" rows="5" required placeholder="Tuliskan informasi berita secara lengkap, mulai dari waktu, tempat, hingga tujuan kegiatan..."></textarea>
                            </div>

                            <div class="form-group mb-0">
                                <div class="publish-label-row">
                                    <label for="berita-foto">Foto Sampul Berita <span class="optional">(opsional)</span></label>
                                    <button type="button" class="publish-clear-photo" id="clear-berita-foto" hidden>Hapus foto</button>
                                </div>

                                <label for="berita-foto" class="upload-dropzone" id="berita-dropzone">
                                    <input id="berita-foto" type="file" name="fotoBerita" accept="image/*" class="visually-hidden">
                                    <div class="upload-dropzone-empty" id="dropzone-empty">
                                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'upload' }) %></span>
                                        <div>
                                            <strong>Klik untuk memilih foto</strong> atau tarik gambar ke area ini
                                            <small>Format JPG, PNG, atau WebP (rasio ideal 16:10)</small>
                                        </div>
                                    </div>
                                    <div class="upload-dropzone-picked" id="dropzone-picked" hidden>
                                        <img id="dropzone-thumb" src="" alt="Pratinjau foto">
                                        <div class="upload-picked-meta">
                                            <strong id="dropzone-filename">foto.jpg</strong>
                                            <small id="dropzone-filesize">0 KB — Klik untuk mengganti foto</small>
                                        </div>
                                    </div>
                                </label>
                            </div>

                            <div class="publish-footer">
                                <div class="publish-meta-note">
                                    <%- include('partials/icon', { name: 'calendar' }) %>
                                    <span>Terbit: <strong><%= tanggalHariIni %></strong></span>
                                </div>
                                <div class="form-actions mt-0">
                                    <a href="/admin/daftar-berita" class="btn btn-outline btn-sm">Batal</a>
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <%- include('partials/icon', { name: 'check-circle' }) %>
                                        <span>Terbitkan Sekarang</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </section>

                    <!-- Kolom Kanan: Pratinjau Langsung -->
                    <aside class="publish-aside">
                        <div class="card publish-preview-shell">
                            <div class="publish-preview-head">
                                <span class="eyebrow">Pratinjau Beranda</span>
                                <span class="badge badge-primary">Live Preview</span>
                            </div>

                            <article class="card news-card publish-preview-card">
                                <div class="news-card-image">
                                    <img id="preview-news-img" src="" alt="Pratinjau Foto Berita" hidden>
                                    <div class="news-card-placeholder" id="preview-news-placeholder">
                                        <%- include('partials/icon', { name: 'news' }) %>
                                    </div>
                                </div>
                                <div class="news-card-body">
                                    <span class="meta-date"><%- include('partials/icon', { name: 'calendar' }) %><%= tanggalHariIni %></span>
                                    <h3 id="preview-news-title">Judul berita akan tampil di sini...</h3>
                                    <p class="news-summary" id="preview-news-summary">Tuliskan isi berita pada formulir di samping untuk melihat pratinjau ringkasan berita secara langsung.</p>
                                    <span class="read-more">Baca selengkapnya <span aria-hidden="true">↓</span></span>
                                </div>
                            </article>
                        </div>
                    </aside>
                </div>
            <% } else if (activeSection === 'laporan-warga') { %>
                <!-- HALAMAN 4: LAPORAN WARGA -->
                <section class="card admin-section">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'inbox' }) %></span> Daftar Laporan &amp; Aspirasi Warga</h2>
                            <p class="card-subtitle">Seluruh masukan, saran, dan pengaduan yang dikirim warga melalui portal.</p>
                        </div>
                        <span class="badge"><%= daftarLaporan.length %> laporan</span>
                    </div>
                    <% if (daftarLaporan.length > 0) { %>
                        <div class="item-list">
                            <% daftarLaporan.forEach(function(laporan) { %>
                                <article class="item">
                                    <div class="item-head">
                                        <span class="item-title"><%= laporan.nama %></span>
                                        <span class="badge badge-primary"><%= laporan.tipe %></span>
                                    </div>
                                    <% if (laporan.tanggal) { %>
                                        <div class="item-meta"><span><%= laporan.tanggal %></span></div>
                                    <% } %>
                                    <p><%= laporan.isi %></p>
                                    <% if (laporan.foto) { %>
                                        <img class="item-image" src="<%= imgSrc(laporan.foto) %>" alt="Foto laporan dari <%= laporan.nama %>" loading="lazy">
                                    <% } %>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <span class="icon-box"><%- include('partials/icon', { name: 'inbox' }) %></span>
                            <h3>Belum ada laporan</h3>
                            <p>Laporan dan aspirasi yang dikirim oleh warga akan muncul di halaman ini.</p>
                        </div>
                    <% } %>
                </section>
            <% } else if (activeSection === 'surat-pengantar') { %>
                <!-- HALAMAN 5: SURAT PENGANTAR -->
                <%
                    const suratSelesai = daftarSurat.filter(s => s.status === 'Disetujui' || s.status === 'Ditolak').length;
                %>
                <section class="card admin-section">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'document' }) %></span> Daftar Pengajuan Surat Pengantar</h2>
                            <p class="card-subtitle">Konfirmasi, tolak, atau hapus riwayat pengajuan surat dari warga.</p>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                            <span class="badge badge-warning"><%= suratMenunggu %> menunggu</span>
                            <% if (suratSelesai > 0) { %>
                                <form action="/admin/surat-pengantar/hapus-selesai" method="POST" data-confirm-title="Bersihkan Riwayat Surat?" data-confirm="Apakah Anda yakin ingin menghapus seluruh (<%= suratSelesai %>) riwayat surat yang sudah Disetujui maupun Ditolak?" style="margin: 0;">
                                    <button type="submit" class="btn btn-danger-soft btn-sm">
                                        <%- include('partials/icon', { name: 'trash' }) %>
                                        <span>Bersihkan Riwayat Selesai (<%= suratSelesai %>)</span>
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                    <% if (daftarSurat.length > 0) { %>
                        <div class="item-list">
                            <% daftarSurat.forEach(function(surat) {
                                const status = surat.status || 'Menunggu';
                            %>
                                <article class="item <%= status === 'Ditolak' ? 'is-danger' : (status === 'Disetujui' ? '' : 'is-secondary') %>">
                                    <div class="item-head">
                                        <span class="item-title"><%= surat.nama %> — <%= surat.keperluan %></span>
                                        <span class="badge <%= statusBadge(status) %>"><%= status %></span>
                                    </div>
                                    <div class="item-meta">
                                        <% if (surat.tanggal) { %><span><%= surat.tanggal %></span><% } %>
                                        <span><strong>NIK:</strong> <%= surat.nik %></span>
                                        <span><strong>HP:</strong> <%= surat.no_hp %></span>
                                    </div>
                                    <p><strong>Alamat:</strong> <%= surat.alamat %></p>
                                    <% if (surat.catatan) { %>
                                        <p><strong>Catatan:</strong> <%= surat.catatan %></p>
                                    <% } %>
                                    <% if (status === 'Ditolak' && surat.alasan_penolakan) { %>
                                        <p class="item-note-danger"><strong>Alasan penolakan:</strong> <%= surat.alasan_penolakan %></p>
                                    <% } %>
                                    <% if (status === 'Menunggu') { %>
                                        <div class="item-actions">
                                            <form action="/admin/surat-pengantar/<%= surat.id %>/status" method="POST">
                                                <input type="hidden" name="action" value="konfirmasi">
                                                <button type="submit" class="btn btn-primary btn-sm"><%- include('partials/icon', { name: 'check-circle' }) %> Konfirmasi</button>
                                            </form>
                                            <form action="/admin/surat-pengantar/<%= surat.id %>/status" method="POST" class="reject-form">
                                                <input type="hidden" name="action" value="tolak">
                                                <label class="visually-hidden" for="alasan-<%= surat.id %>">Alasan penolakan</label>
                                                <textarea id="alasan-<%= surat.id %>" name="alasanPenolakan" rows="1" required placeholder="Alasan penolakan..."></textarea>
                                                <button type="submit" class="btn btn-danger-soft btn-sm">Tolak</button>
                                            </form>
                                        </div>
                                    <% } else { %>
                                        <div class="item-actions">
                                            <form action="/admin/surat-pengantar/<%= surat.id %>/hapus" method="POST" data-confirm-title="Hapus Riwayat Surat?" data-confirm="Apakah Anda yakin ingin menghapus riwayat pengajuan surat <%= surat.keperluan %> dari <%= surat.nama %>?">
                                                <button type="submit" class="btn btn-danger-soft btn-sm">
                                                    <%- include('partials/icon', { name: 'trash' }) %>
                                                    <span>Hapus Riwayat</span>
                                                </button>
                                            </form>
                                        </div>
                                    <% } %>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <span class="icon-box"><%- include('partials/icon', { name: 'document' }) %></span>
                            <h3>Belum ada pengajuan surat</h3>
                            <p>Permohonan surat pengantar dari warga akan tampil di halaman ini.</p>
                        </div>
                    <% } %>
                </section>
            <% } else if (activeSection === 'kelola-galeri') { %>
                <!-- HALAMAN 6: KELOLA GALERI -->
                <section class="card admin-section">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'image' }) %></span> Kelola Galeri Kegiatan</h2>
                            <p class="card-subtitle">Tambahkan hingga 10 foto untuk satu kegiatan. Foto akan tampil di halaman galeri publik.</p>
                        </div>
                        <a class="link-arrow" href="/galeri">Lihat galeri publik <span aria-hidden="true">→</span></a>
                    </div>
                    <div class="gallery-admin-layout">
                        <form action="/admin/tambah-galeri" method="POST" enctype="multipart/form-data" class="gallery-upload-form" data-cloud-upload="<%= isVercel ? 'true' : 'false' %>">
                            <div class="form-group">
                                <label for="gallery-title">Nama Kegiatan</label>
                                <input id="gallery-title" type="text" name="judul" maxlength="255" required placeholder="Contoh: Kerja Bakti Lingkungan">
                            </div>
                            <div class="form-group">
                                <label for="gallery-description">Keterangan <span class="optional">(opsional)</span></label>
                                <textarea id="gallery-description" name="deskripsi" rows="3" placeholder="Ceritakan singkat kegiatan ini"></textarea>
                            </div>
                            <div class="form-group">
                                <label for="gallery-photos">Foto Dokumentasi</label>
                                <input id="gallery-photos" type="file" name="fotoGaleri" accept="image/jpeg,image/png,image/webp" multiple required>
                                <small class="form-hint">Maksimal 10 foto, masing-masing maksimal 3 MB (JPEG, PNG, WebP).</small>
                            </div>
                            <button type="submit" class="btn btn-primary btn-block"><%- include('partials/icon', { name: 'upload' }) %> Simpan Dokumentasi</button>
                            <p class="gallery-upload-status" aria-live="polite"></p>
                        </form>

                        <div>
                            <% if (daftarGaleri.length) { %>
                                <div class="admin-gallery-list">
                                    <% daftarGaleri.forEach(function(item) { %>
                                        <article class="admin-gallery-item">
                                            <img src="<%= imgSrc(item.foto) %>" alt="<%= item.judul %>" loading="lazy" decoding="async">
                                            <div class="admin-gallery-item-info">
                                                <strong><%= item.judul %></strong>
                                                <span><%= item.tanggal %></span>
                                            </div>
                                            <form action="/admin/hapus-galeri/<%= item.id %>" method="POST" data-confirm-title="Hapus Dokumentasi Galeri?" data-confirm="Apakah Anda yakin ingin menghapus foto dokumentasi &quot;<%= item.judul %>&quot; dari galeri desa?">
                                                <button type="submit" class="btn btn-danger-soft btn-sm btn-block"><%- include('partials/icon', { name: 'trash' }) %> Hapus</button>
                                            </form>
                                        </article>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <span class="icon-box"><%- include('partials/icon', { name: 'image' }) %></span>
                                    <p>Belum ada dokumentasi yang disimpan.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </section>
            <% } else if (activeSection === 'daftar-berita') { %>
                <!-- HALAMAN 7: DAFTAR BERITA -->
                <section class="card admin-section">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'news' }) %></span> Berita Desa Saat Ini</h2>
                            <p class="card-subtitle">Kelola seluruh berita yang telah dipublikasikan.</p>
                        </div>
                        <a href="/admin/terbitkan-berita" class="btn btn-primary btn-sm"><%- include('partials/icon', { name: 'megaphone' }) %> Tambah Berita Baru</a>
                    </div>
                    <% if (daftarBerita.length) { %>
                        <div class="admin-news-grid">
                            <% daftarBerita.forEach(function(b) { %>
                                <article class="admin-news-item">
                                    <span class="meta-date"><%- include('partials/icon', { name: 'calendar' }) %><%= b.tanggal %></span>
                                    <h4><%= b.judul %></h4>
                                    <p><%= (b.ringkasan || '').length > 130 ? b.ringkasan.substring(0, 130) + '…' : b.ringkasan %></p>
                                    <div class="item-actions">
                                        <a href="/admin/edit-berita/<%= b.id %>" class="btn btn-outline btn-sm"><%- include('partials/icon', { name: 'edit' }) %> Edit</a>
                                        <form action="/admin/hapus-berita/<%= b.id %>" method="POST" data-confirm-title="Hapus Berita Desa?" data-confirm="Apakah Anda yakin ingin menghapus berita &quot;<%= b.judul %>&quot; secara permanen?">
                                            <button type="submit" class="btn btn-danger-soft btn-sm"><%- include('partials/icon', { name: 'trash' }) %> Hapus</button>
                                        </form>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <span class="icon-box"><%- include('partials/icon', { name: 'news' }) %></span>
                            <h3>Belum ada berita</h3>
                            <p>Silakan terbitkan berita pertama untuk warga desa.</p>
                            <a href="/admin/terbitkan-berita" class="btn btn-primary">Terbitkan Berita</a>
                        </div>
                    <% } %>
                </section>
            <% } %>
        </main>

        <%- include('partials/footer', { simple: true }) %>
    </div>
</div>

