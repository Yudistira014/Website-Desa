<% if (activeSection === 'bantuan-desa') { %>
<script>
    (() => {
        document.querySelectorAll('[data-aid-donut-deg]').forEach(el => {
            const deg = Number.parseFloat(el.getAttribute('data-aid-donut-deg')) || 0;
            el.style.background = `conic-gradient(#12704f 0deg ${deg}deg, #d9a521 ${deg}deg 360deg)`;
        });
        document.querySelectorAll('[data-bar-width]').forEach(el => {
            const w = Number.parseFloat(el.getAttribute('data-bar-width')) || 0;
            el.style.width = `${w}%`;
        });

        const displayInput = document.getElementById('aid-nominal-display');
        const hiddenInput = document.getElementById('aid-nominal');
        if (displayInput && hiddenInput) {
            displayInput.addEventListener('input', () => {
                const digits = displayInput.value.replace(/\D/g, '');
                hiddenInput.value = digits;
                displayInput.value = digits ? Number.parseInt(digits, 10).toLocaleString('id-ID') : '';
            });
        }

        const filterBtns = document.querySelectorAll('[data-aid-filter]');
        const rows = document.querySelectorAll('tr[data-aid-row]');
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const target = btn.getAttribute('data-aid-filter');
                filterBtns.forEach(b => b.classList.toggle('is-active', b === btn));
                rows.forEach(row => {
                    const status = row.getAttribute('data-aid-row');
                    row.hidden = target !== 'all' && status !== target;
                });
            });
        });
