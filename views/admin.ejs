        });
        document.querySelectorAll('[data-bar-width]').forEach(el => {
            const w = Number.parseFloat(el.getAttribute('data-bar-width')) || 0;
            el.style.width = `${w}%`;
        });

        // Format input nominal otomatis dengan pemisah ribuan (titik)
        const displayInput = document.getElementById('fin-nominal-display');
        const hiddenInput = document.getElementById('fin-nominal');
        const selectKategori = document.getElementById('fin-kategori');
        const optMasuk = document.getElementById('opt-masuk');
        const optKeluar = document.getElementById('opt-keluar');
        const radios = document.querySelectorAll('input[name="tipe"]');

        if (displayInput && hiddenInput) {
            displayInput.addEventListener('input', () => {
                const digits = displayInput.value.replace(/\D/g, '');
                hiddenInput.value = digits;
                displayInput.value = digits ? Number.parseInt(digits, 10).toLocaleString('id-ID') : '';
            });
        }

        // Sesuaikan pilihan default kategori saat jenis transaksi diganti
        if (radios.length && selectKategori && optMasuk && optKeluar) {
            radios.forEach(radio => {
                radio.addEventListener('change', () => {
                    const isMasuk = radio.value === 'masuk';
                    const firstOption = (isMasuk ? optMasuk : optKeluar).querySelector('option');
                    if (firstOption) selectKategori.value = firstOption.value;
                });
            });
        }

        // Filter tab riwayat transaksi (Semua / Masuk / Keluar)
        const filterBtns = document.querySelectorAll('[data-fin-filter]');
        const ledgerRows = document.querySelectorAll('tr[data-fin-row]');
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
