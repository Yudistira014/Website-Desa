<%- include('partials/head', { title: 'Edit Berita', bodyClass: 'page-muted admin-body' }) %>

<% const imgSrc = foto => /^https?:\/\//i.test(foto) ? foto : '/' + foto; %>

<div class="admin-shell">
    <%- include('partials/admin-sidebar', {
        activeMenu: 'daftar-berita',
        baseHref: '/admin'
    }) %>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-left">
                <button type="button" class="admin-menu-btn" data-admin-menu-toggle aria-label="Buka menu navigasi">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <span class="eyebrow">Panel Administrasi</span>
                    <h1>Edit Berita</h1>
                    <p>Perbarui isi berita dan pastikan informasinya tetap akurat bagi pembaca.</p>
                </div>
            </div>
            <div class="admin-topbar-actions">
                <a href="/admin#daftar-berita" class="btn btn-outline btn-sm"><%- include('partials/icon', { name: 'arrow-left' }) %> Kembali</a>
            </div>
        </header>

        <main id="konten" class="admin-content">
            <section class="card" style="max-width: 780px;">
                <form action="/admin/edit-berita/<%= id %>" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="edit-judul">Judul Berita</label>
                        <input id="edit-judul" type="text" name="judul" value="<%= berita.judul %>" required>
                    </div>
                    <div class="form-group">
                        <label for="edit-ringkasan">Isi Berita</label>
                        <textarea id="edit-ringkasan" name="ringkasan" rows="9" required><%= berita.ringkasan %></textarea>
                    </div>
                    <% if (berita.foto) { %>
                        <div class="current-image">
                            <span class="form-label">Foto saat ini</span>
                            <img src="<%= imgSrc(berita.foto) %>" alt="Foto berita saat ini">
                        </div>
                    <% } %>
                    <div class="form-group">
                        <label for="edit-foto">Ganti Foto <span class="optional">(opsional)</span></label>
                        <input id="edit-foto" type="file" name="fotoBerita" accept="image/*">
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                        <a href="/admin#daftar-berita" class="btn btn-outline">Batal</a>
                    </div>
                </form>
            </section>
        </main>

        <%- include('partials/footer', { simple: true }) %>
    </div>
</div>

<%- include('partials/end') %>
