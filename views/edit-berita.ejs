<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Berita - Portal <%= desa.nama %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light">
    <nav class="navbar">
        <div class="nav-brand">
            <img src="/uploads/Logo_desa.png" alt="Logo Desa" class="brand-icon" />
            <div class="brand-text">Admin<span>Panel</span></div>
        </div>
        <button class="menu-toggle" type="button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="nav-links">
            <span></span><span></span><span></span>
        </button>
        <ul class="nav-links" id="nav-links">
            <li><a href="/admin">Kembali ke Dashboard</a></li>
        </ul>
    </nav>

    <main class="section bg-light edit-page">
        <div class="section-header">
            <h2>Edit Berita</h2>
            <p class="section-description">Sunting berita desa dengan tampilan profesional dan pastikan informasi tetap akurat bagi pembaca.</p>
        </div>

        <div class="card edit-card animate-fade-in">
            <form action="/admin/edit-berita/<%= id %>" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label>Judul Berita</label>
                    <input type="text" name="judul" value="<%= berita.judul %>" required>
                </div>
                <div class="form-group">
                    <label>Ringkasan Informasi</label>
                    <textarea name="ringkasan" rows="8" required><%= berita.ringkasan %></textarea>
                </div>
                <div class="form-group">
                    <label>Foto Berita Baru (opsional)</label>
                    <input type="file" name="fotoBerita" accept="image/*">
                </div>
                <% if (berita.foto) { %>
                    <div class="current-image-wrapper">
                        <strong>Foto saat ini</strong>
                        <img src="/<%= berita.foto %>" alt="Foto Berita">
                    </div>
                <% } %>
                <button type="submit" class="btn-primary" style="width: 100%;">Simpan Perubahan</button>
            </form>
        </div>
    </main>
    <script src="/navigation.js?v=20261116"></script>
</body>
</html>