<%- include('partials/head', { title: 'Edit Laporan', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar-dashboard') %>

<% const imgSrc = foto => /^https?:\/\//i.test(foto) ? foto : '/' + foto; %>

<main id="konten">
    <header class="dash-header">
        <div class="container container-narrow dash-header-inner">
            <div>
                <span class="eyebrow">Layanan Mandiri Warga</span>
                <h1>Edit Laporan</h1>
                <p>Perbarui detail laporan atau aspirasi yang sudah Anda kirim.</p>
            </div>
            <a href="/user" class="btn btn-outline"><%- include('partials/icon', { name: 'arrow-left' }) %> Kembali</a>
        </div>
    </header>

    <div class="dash-body">
        <div class="container container-narrow">
            <section class="card">
                <form action="/user/edit-laporan/<%= laporan.id %>" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="edit-tipe">Tipe Laporan</label>
                        <select id="edit-tipe" name="tipe" required>
                            <option value="Saran" <%= laporan.tipe === 'Saran' ? 'selected' : '' %>>Saran</option>
                            <option value="Keluhan" <%= laporan.tipe === 'Keluhan' ? 'selected' : '' %>>Keluhan/Pengaduan</option>
                            <option value="Permohonan" <%= laporan.tipe === 'Permohonan' ? 'selected' : '' %>>Permohonan Informasi</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="edit-isi">Isi Laporan</label>
                        <textarea id="edit-isi" name="isi" rows="7" required><%= laporan.isi %></textarea>
                    </div>
                    <% if (laporan.foto) { %>
                        <div class="current-image">
                            <span class="form-label">Foto saat ini</span>
                            <img src="<%= imgSrc(laporan.foto) %>" alt="Foto laporan saat ini">
                        </div>
                    <% } %>
                    <div class="form-group">
                        <label for="edit-foto">Ganti Foto Pendukung <span class="optional">(opsional)</span></label>
                        <input id="edit-foto" type="file" name="fotoLaporan" accept="image/*">
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                        <a href="/user" class="btn btn-outline">Batal</a>
                    </div>
                </form>
            </section>
        </div>
    </div>
</main>

<%- include('partials/footer', { simple: true }) %>
<%- include('partials/end') %>
