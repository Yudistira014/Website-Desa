<%- include('partials/head', { title: 'Galeri Kegiatan' }) %>
<%- include('partials/navbar', { active: 'galeri' }) %>

<% const imgSrc = foto => /^https?:\/\//i.test(foto) ? foto : '/' + foto; %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: 'Galeri Kegiatan',
        lead: 'Dokumentasi kegiatan, program, dan kebersamaan masyarakat ' + desa.nama + '.',
        crumbs: [{ label: 'Galeri' }]
    }) %>

    <section class="section section-alt" aria-label="Dokumentasi kegiatan desa">
        <div class="container">
            <% if (galeri && galeri.length) { %>
                <div class="gallery-grid">
                    <% galeri.forEach(function(item) { %>
                        <article class="card gallery-card">
                            <a class="gallery-tile" href="<%= imgSrc(item.foto) %>" target="_blank" rel="noopener noreferrer" aria-label="Buka foto: <%= item.judul %>">
                                <img src="<%= imgSrc(item.foto) %>" alt="<%= item.judul %>" loading="lazy" decoding="async">
                            </a>
                            <div class="gallery-card-body">
                                <span class="meta-date"><%- include('partials/icon', { name: 'calendar' }) %><%= item.tanggal %></span>
                                <h2><%= item.judul %></h2>
                                <% if (item.deskripsi) { %>
                                    <p><%= item.deskripsi %></p>
                                <% } %>
                            </div>
                        </article>
                    <% }); %>
                </div>

                <% if (totalPages > 1) { %>
                    <nav class="pagination" aria-label="Navigasi halaman galeri">
                        <% if (currentPage > 1) { %>
                            <a class="btn btn-outline btn-sm" href="/galeri?page=<%= currentPage - 1 %>"><%- include('partials/icon', { name: 'arrow-left' }) %> Sebelumnya</a>
                        <% } else { %>
                            <span></span>
                        <% } %>
                        <span class="pagination-info">Halaman <strong><%= currentPage %></strong> dari <%= totalPages %></span>
                        <% if (currentPage < totalPages) { %>
                            <a class="btn btn-outline btn-sm" href="/galeri?page=<%= currentPage + 1 %>">Berikutnya <%- include('partials/icon', { name: 'arrow-right' }) %></a>
                        <% } else { %>
                            <span></span>
                        <% } %>
                    </nav>
                <% } %>
            <% } else { %>
                <div class="empty-state">
                    <span class="icon-box"><%- include('partials/icon', { name: 'image' }) %></span>
                    <h3>Belum ada dokumentasi</h3>
                    <p>Dokumentasi kegiatan desa akan ditampilkan di halaman ini.</p>
                    <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
