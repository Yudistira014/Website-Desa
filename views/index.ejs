<%- include('partials/head', { title: 'Beranda' }) %>
<%- include('partials/navbar', { active: 'beranda' }) %>

<%
const serviceIcon = {
    'surat-pengantar': 'document',
    'kontak-darurat': 'phone',
    'data-kependudukan': 'users',
    'layanan-kesehatan': 'health',
    'bantuan-sosial': 'heart'
};
const imgSrc = foto => /^https?:\/\//i.test(foto) ? foto : '/' + foto;
%>

<main id="konten">
    <!-- Hero -->
    <section class="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-2" aria-hidden="true"></div>
        <div class="container">
            <div class="hero-inner">
                <span class="eyebrow hero-enter hero-enter-1"><span class="eyebrow-dot"></span> Portal Resmi Pemerintah Desa</span>
                <h1 class="hero-enter hero-enter-2">Selamat Datang di <span class="hero-highlight"><%= desa.nama %></span></h1>
                <p class="hero-lead hero-enter hero-enter-3"><%= desa.tagline || 'Pusat informasi, layanan administrasi, dan kabar terbaru untuk seluruh warga desa — mudah diakses kapan saja.' %></p>
                <div class="hero-actions hero-enter hero-enter-4">
                    <a href="#layanan" class="btn btn-light btn-shine">Jelajahi Layanan <%- include('partials/icon', { name: 'arrow-right' }) %></a>
                    <a href="/profil/visi-misi" class="btn btn-ghost-light">Kenali Desa Kami</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Ringkasan desa -->
    <section class="hero-stats" aria-label="Ringkasan desa">
        <div class="container">
            <div class="hero-stats-grid" data-reveal="up">
                <div class="hero-stat">
                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'user' }) %></span>
                    <div><strong><%= desa.kepalaDesa %></strong><span>Kepala Desa</span></div>
                </div>
                <div class="hero-stat">
                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'users' }) %></span>
                    <div><strong><span data-countup="<%= desa.populasi %>"><%= desa.populasi %></span> Jiwa</strong><span>Jumlah Penduduk</span></div>
                </div>
                <div class="hero-stat">
                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'map' }) %></span>
                    <div><strong><span data-countup="<%= desa.wilayah.dusun.length %>"><%= desa.wilayah.dusun.length %></span> Dusun</strong><span>Wilayah Administratif</span></div>
                </div>
                <div class="hero-stat">
                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'layers' }) %></span>
                    <div><strong><span data-countup="<%= desa.layanan.length %>"><%= desa.layanan.length %></span> Layanan</strong><span>Layanan Masyarakat</span></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Layanan -->
    <section id="layanan" class="section">
        <div class="container">
            <div class="section-header" data-reveal="up">
                <span class="eyebrow">Layanan untuk warga</span>
                <h2>Layanan Masyarakat</h2>
                <p>Akses cepat untuk berbagai kebutuhan administrasi dan pelayanan publik desa.</p>
            </div>
            <div class="grid grid-3">
                <% desa.layanan.forEach(function(item, idx) { %>
                    <article class="card service-card" data-reveal="up" data-reveal-delay="<%= idx * 80 %>">
                        <span class="icon-box"><%- include('partials/icon', { name: serviceIcon[item.slug] || 'home' }) %></span>
                        <h3><%= item.nama %></h3>
                        <p><%= item.desc %></p>
                        <a href="/layanan/<%= item.slug %>" class="link-arrow">Pelajari layanan <span aria-hidden="true">→</span></a>
                    </article>
                <% }); %>
                <article class="card service-card" data-reveal="up" data-reveal-delay="<%= desa.layanan.length * 80 %>">
                    <span class="icon-box icon-box-accent"><%- include('partials/icon', { name: 'chat' }) %></span>
                    <h3>Pengaduan &amp; Aspirasi</h3>
                    <p>Sampaikan keluhan, saran, atau permohonan informasi langsung kepada pemerintah desa.</p>
                    <a href="/layanan/pengaduan" class="link-arrow">Sampaikan aspirasi <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </div>
    </section>

    <!-- Tentang desa -->
    <section class="section section-alt">
        <div class="container about-grid">
            <div class="about-copy" data-reveal="left">
                <span class="eyebrow">Tentang desa</span>
                <h2>Mengenal <%= desa.nama %></h2>
                <p><%= desa.wilayah.deskripsi %></p>
                <div class="about-links">
                    <a href="/profil/visi-misi" class="card feature-card" data-reveal="up" style="--reveal-delay: 80ms">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'target' }) %></span>
                        <div><h3>Visi &amp; Misi</h3><p>Arah kebijakan dan cita-cita pembangunan desa.</p></div>
                    </a>
                    <a href="/profil/wilayah-desa" class="card feature-card" data-reveal="up" style="--reveal-delay: 160ms">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'map' }) %></span>
                        <div><h3>Wilayah Desa</h3><p>Kondisi geografis dan pembagian dusun.</p></div>
                    </a>
                    <a href="/pemerintahan/desa" class="card feature-card" data-reveal="up" style="--reveal-delay: 240ms">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'building' }) %></span>
                        <div><h3>Pemerintahan</h3><p>Struktur pemerintah desa, BPD, dan LPMD.</p></div>
                    </a>
                </div>
            </div>
            <div class="quote-card quote-card-animated" data-reveal="right">
                <span class="eyebrow">Visi Desa</span>
                <blockquote>“<%= desa.visi %>”</blockquote>
            </div>
        </div>
    </section>

    <!-- Berita -->
    <section id="berita" class="section">
        <div class="container">
            <div class="section-header" data-reveal="up">
                <span class="eyebrow">Kabar dan kegiatan</span>
                <h2>Berita Desa Terbaru</h2>
                <p>Informasi dan transparansi kegiatan desa terkini.</p>
            </div>
            <% if (berita && berita.length) { %>
                <div class="grid grid-3">
                    <% berita.forEach(function(item, idx) { %>
                        <article class="card news-card" data-reveal="up" data-reveal-delay="<%= idx * 95 %>">
                            <div class="news-card-image">
                                <% if (item.foto) { %>
                                    <img src="<%= imgSrc(item.foto) %>" alt="<%= item.judul %>" loading="lazy" decoding="async">
                                <% } else { %>
                                    <div class="news-card-placeholder"><%- include('partials/icon', { name: 'news' }) %></div>
                                <% } %>
                            </div>
                            <div class="news-card-body">
                                <span class="meta-date"><%- include('partials/icon', { name: 'calendar' }) %><%= item.tanggal %></span>
                                <h3><%= item.judul %></h3>
                                <p class="news-summary"><%= item.ringkasan %></p>
                                <button type="button" class="read-more" aria-expanded="false"><span class="read-more-label">Baca selengkapnya</span> <span aria-hidden="true" class="read-more-icon">↓</span></button>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state" data-reveal="up">
                    <span class="icon-box"><%- include('partials/icon', { name: 'news' }) %></span>
                    <h3>Belum ada berita</h3>
                    <p>Berita terbaru akan ditampilkan di sini. Silakan kembali lagi nanti.</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Galeri -->
    <section id="galeri" class="section section-alt">
        <div class="container">
            <div class="section-header section-header-split" data-reveal="up">
                <div>
                    <span class="eyebrow">Dokumentasi kegiatan</span>
                    <h2>Galeri Kegiatan Desa</h2>
                    <p>Potret kegiatan dan kebersamaan warga <%= desa.nama %>.</p>
                </div>
                <% if (galeri && galeri.length) { %>
                    <a class="btn btn-outline" href="/galeri">Lihat semua dokumentasi <%- include('partials/icon', { name: 'arrow-right' }) %></a>
                <% } %>
            </div>
            <% if (galeri && galeri.length) { %>
                <div class="gallery-grid">
                    <% galeri.forEach(function(item, idx) { %>
                        <a class="gallery-tile" href="/galeri" aria-label="Lihat galeri: <%= item.judul %>" data-reveal="scale" data-reveal-delay="<%= idx * 80 %>">
                            <img src="<%= imgSrc(item.foto) %>" alt="<%= item.judul %>" loading="lazy" decoding="async">
                            <span class="gallery-tile-caption">
                                <span><%= item.tanggal %></span>
                                <strong><%= item.judul %></strong>
                            </span>
                        </a>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state" data-reveal="up">
                    <span class="icon-box"><%- include('partials/icon', { name: 'image' }) %></span>
                    <h3>Belum ada dokumentasi</h3>
                    <p>Dokumentasi kegiatan desa akan ditampilkan di sini.</p>
                </div>
            <% } %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<script>
    (() => {
        // 1. Expand / collapse ringkasan berita
        document.querySelectorAll('.news-card .read-more').forEach(button => {
            const card = button.closest('.news-card');
            const summary = card && card.querySelector('.news-summary');
            if (!summary) return;

            if (summary.scrollHeight <= summary.clientHeight + 2) {
                button.hidden = true;
                return;
            }

            button.addEventListener('click', () => {
                const isExpanded = card.classList.toggle('expanded');
                button.setAttribute('aria-expanded', String(isExpanded));
                button.querySelector('.read-more-label').textContent = isExpanded ? 'Ringkas berita' : 'Baca selengkapnya';
                button.querySelector('.read-more-icon').textContent = isExpanded ? '↑' : '↓';
            });
        });

        // 2. Scroll-reveal modern dengan IntersectionObserver
        const revealEls = document.querySelectorAll('[data-reveal]');
        revealEls.forEach(el => {
            const delay = el.getAttribute('data-reveal-delay');
            if (delay) el.style.setProperty('--reveal-delay', `${delay}ms`);
        });
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (prefersReduced || !('IntersectionObserver' in window)) {
            revealEls.forEach(el => el.classList.add('is-visible'));
        } else {
            const revealObserver = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.14, rootMargin: '0px 0px -40px 0px' });

            revealEls.forEach(el => revealObserver.observe(el));
        }

        // 3. Animasi hitung angka (Count-Up) pada bar statistik
        const countEls = document.querySelectorAll('[data-countup]');
        const animateCount = el => {
            const raw = (el.getAttribute('data-countup') || '').trim();
            const target = Number.parseInt(raw.replace(/\D/g, ''), 10);
            if (!Number.isFinite(target) || prefersReduced) return;
            if (target === 0) {
                el.textContent = '0';
                return;
            }

            const useLocale = raw.includes('.') || target >= 1000;
            const duration = 1400;
            const start = performance.now();

            const step = now => {
                const progress = Math.min(1, (now - start) / duration);
                const eased = 1 - Math.pow(1 - progress, 4); // easeOutQuart
                const current = Math.round(target * eased);
                el.textContent = useLocale ? current.toLocaleString('id-ID') : String(current);
                if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
        };

        if ('IntersectionObserver' in window && !prefersReduced) {
            const countObserver = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        animateCount(entry.target);
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });
            countEls.forEach(el => countObserver.observe(el));
        }
    })();
</script>
<%- include('partials/end') %>
