<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beranda - <%= desa.nama %></title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css?v=20261116">
</head>
<body>
   <nav class="navbar">
        <div class="nav-brand">
            <img src="/uploads/Logo_desa.png" alt="Logo Desa" class="brand-icon" />
            <div class="brand-text"><span><%= desa.nama %></span></div>
        </div>
        
        <button class="menu-toggle" type="button" aria-label="Buka menu navigasi" aria-expanded="false" aria-controls="nav-links">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <ul class="nav-links" id="nav-links">
            <li><a href="/">Beranda</a></li>
            
            <li class="nav-item">
                <a href="#">Profil Desa ▾</a>
                <ul class="dropdown">
                    <li><a href="/profil">Visi & Misi</a></li>
                    <li><a href="/profil/wilayah-desa">Wilayah Desa</a></li>
                </ul>
            </li>
            
            <li class="nav-item">
                <a href="#">Pemerintahan ▾</a>
                <ul class="dropdown">
                    <li><a href="/pemerintahan/desa">Pemerintah Desa</a></li>
                    <li><a href="/pemerintahan/bpd">BPD</a></li>
                    <li><a href="/pemerintahan/lpmd">LPMD</a></li>
                </ul>
            </li>
            
            <li class="nav-item">
                <a href="#">Layanan ▾</a>
                <ul class="dropdown">
                    <li><a href="#layanan">Persuratan</a></li>
                    <li><a href="/layanan/pengaduan">Pengaduan</a></li>
                </ul>
            </li>
            
            <li><a href="#berita">Berita</a></li>
            <li><a href="#kontak">Hubungi Kami</a></li>

            <% if (user) { %>
                <li><a href="/<%= user.role %>" class="btn-primary">Dashboard</a></li>
                <li><a href="/logout" style="color: #ef4444; font-weight: bold;">Logout</a></li>
            <% } else { %>
                <li><a href="/login" class="btn-primary">Login</a></li>
            <% } %>
        </ul>
    </nav>

    <header class="hero home-hero">
        <div class="hero-content home-hero-content">
            <p class="hero-eyebrow"><span aria-hidden="true"></span> Portal Resmi Pemerintah Desa</p>
            <h1>Selamat Datang di <%= desa.nama %></h1>
            <p><%= desa.tagline %></p>
            <div class="hero-actions">
                <a href="#layanan" class="btn-secondary">Jelajahi Layanan <span aria-hidden="true">→</span></a>
                <a href="/profil" class="hero-link">Kenali Desa Kami <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </header>

    <section id="layanan" class="section home-services">
        <div class="section-header">
            <span class="section-kicker">Layanan untuk warga</span>
            <h2>Layanan Masyarakat</h2>
            <p>Akses cepat untuk berbagai kebutuhan administrasi desa.</p>
        </div>
        <div class="grid-container service-grid">
            <% desa.layanan.forEach(function(item) { %>
                <article class="card service-card">
                    <span class="icon service-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <% if (item.slug === 'surat-pengantar') { %>
                                <path d="M7 3.75h6.5L18 8.25v12H7z" />
                                <path d="M13.5 3.75v4.5H18M9.5 12h5M9.5 15.5h5" />
                            <% } else if (item.slug === 'kontak-darurat') { %>
                                <path d="M7.5 4.5h2.3l1.2 4-1.8 1.7a14 14 0 0 0 4.6 4.6l1.7-1.8 4 1.2v2.3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 5.5 6.7a2 2 0 0 1 2-2.2Z" />
                                <path d="M15.5 4.5h4M17.5 2.5v4" />
                            <% } else if (item.slug === 'data-kependudukan') { %>
                                <circle cx="9" cy="8" r="3" />
                                <path d="M3.5 19v-1a5.5 5.5 0 0 1 11 0v1zM16 5.5a3 3 0 0 1 0 5.8M17 14a4.5 4.5 0 0 1 3.5 4.4v.6h-3" />
                            <% } else if (item.slug === 'layanan-kesehatan') { %>
                                <path d="M12 3.5 19 6v5.5c0 4.2-2.8 7.5-7 9-4.2-1.5-7-4.8-7-9V6z" />
                                <path d="M12 8v7M8.5 11.5h7" />
                            <% } else if (item.slug === 'bantuan-sosial') { %>
                                <path d="M12 19s-7-4.3-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 2.8C19 14.7 12 19 12 19Z" />
                                <path d="M8.5 13h2l1.2-2.2 1.7 4 1.1-1.8h1" />
                            <% } else { %>
                                <path d="M4 10.5 12 4l8 6.5M6.5 9v10h11V9M10 19v-6h4v6" />
                            <% } %>
                        </svg>
                    </span>
                    <h3><%= item.nama %></h3>
                    <p><%= item.desc %></p>
                    <a href="/layanan/<%= item.slug %>" class="service-link">Pelajari layanan <span aria-hidden="true">→</span></a>
                </article>
            <% }); %>
        </div>
    </section>

    <section id="berita" class="section bg-light home-news">
        <div class="section-header">
            <span class="section-kicker">Kabar dan kegiatan</span>
            <h2>Kabar Desa Terbaru</h2>
            <p>Informasi dan transparansi kegiatan desa terkini.</p>
        </div>
        <div class="grid-container news-grid">
            <% if (berita && berita.length) { %>
                <% berita.forEach(function(item) { %>
                <article class="card news-card">
                    <% if (item.foto) { %>
                        <div class="news-card-image">
                            <img src="/<%= item.foto %>" alt="Foto Berita <%= item.judul %>">
                        </div>
                    <% } %>
                    <div class="news-card-details">
                        <span class="date"><%= item.tanggal %></span>
                        <h3><%= item.judul %></h3>
                        <p class="news-summary"><%= item.ringkasan %></p>
                        <button type="button" class="read-more" aria-expanded="false">Baca selengkapnya <span aria-hidden="true">↓</span></button>
                    </div>
                </article>
                <% }); %>
            <% } else { %>
                <p class="news-empty">Belum ada berita terbaru. Silakan kembali lagi nanti.</p>
            <% } %>
        </div>
    </section>

    <footer id="kontak">
        <div class="footer-content">
            <div class="footer-info">
                <h3>Pemerintah <%= desa.nama %></h3>
                <p>Jl. Raya Pembangunan No. 1, Kecamatan Maju, Kabupaten Sejahtera.</p>
                <p>Email: kontak@<%= desa.nama.toLowerCase().replace(' ', '') %>.go.id</p>
            </div>
            <div class="footer-copyright">
                <p>&copy; 2026 Portal Resmi <%= desa.nama %>. Dilindungi Hak Cipta.</p>
            </div>
        </div>
    </footer>

    <script>
        document.querySelectorAll('.news-card .read-more').forEach(button => {
            button.addEventListener('click', event => {
                const card = event.currentTarget.closest('.news-card');
                if (!card) return;
                const isExpanded = card.classList.toggle('expanded');
                event.currentTarget.setAttribute('aria-expanded', String(isExpanded));
                event.currentTarget.querySelector('span').textContent = isExpanded ? '↑' : '↓';
                event.currentTarget.firstChild.textContent = isExpanded ? 'Ringkas berita ' : 'Baca selengkapnya ';
            });
        });
    </script>
    <script src="/navigation.js?v=20261116"></script>
</body>
</html>