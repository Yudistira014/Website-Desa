<%- include('partials/head', { title: layanan.nama, bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'layanan', activeSub: '/layanan/' + layanan.slug }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: layanan.nama,
        lead: layanan.detail.headline,
        crumbs: [{ label: 'Layanan', href: '/#layanan' }, { label: layanan.nama }]
    }) %>

    <section class="section">
        <div class="container layout-sidebar">
            <div class="stack">
                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'document' }) %></span> Tentang Layanan</h2>
                    </div>
                    <p><%= layanan.detail.content %></p>
                </article>

                <div class="grid grid-2">
                    <article class="card">
                        <div class="card-header">
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'clipboard' }) %></span> Cara Menggunakan</h2>
                        </div>
                        <ol class="list-number">
                            <% layanan.detail.langkah.forEach(function(step) { %>
                                <li><span><%= step %></span></li>
                            <% }); %>
                        </ol>
                    </article>

                    <article class="card">
                        <div class="card-header">
                            <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'check-circle' }) %></span> Syarat &amp; Dokumen</h2>
                        </div>
                        <ul class="list-check">
                            <% layanan.detail.syarat.forEach(function(item) { %>
                                <li><%= item %></li>
                            <% }); %>
                        </ul>
                    </article>
                </div>

                <% if (layanan.slug === 'surat-pengantar') { %>
                    <article class="card card-highlight" id="form-pengajuan">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">Form Pengajuan Surat Pengantar</h2>
                                <p class="card-subtitle">Lengkapi data berikut. Status pengajuan dapat dipantau dari dashboard warga.</p>
                            </div>
                        </div>

                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success" role="status"><%- include('partials/icon', { name: 'check-circle' }) %> Pengajuan surat pengantar berhasil dikirim. Kami akan memprosesnya sesegera mungkin.</div>
                        <% } %>
                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-error" role="alert"><%- include('partials/icon', { name: 'alert-circle' }) %> Maaf, pengajuan gagal dikirim. Silakan coba lagi.</div>
                        <% } %>

                        <% if (user) { %>
                            <form action="/layanan/<%= layanan.slug %>/ajukan" method="POST">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="sp-nama">Nama Lengkap</label>
                                        <input id="sp-nama" type="text" name="nama" value="<%= user.username %>" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="sp-nik">NIK</label>
                                        <input id="sp-nik" type="text" name="nik" inputmode="numeric" required placeholder="16 digit NIK">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="sp-keperluan">Keperluan Surat</label>
                                        <select id="sp-keperluan" name="keperluan" required>
                                            <option value="">Pilih keperluan</option>
                                            <option value="SKCK">SKCK</option>
                                            <option value="KTP">KTP</option>
                                            <option value="KK">KK</option>
                                            <option value="Keterangan">Surat Keterangan</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="sp-hp">No. HP / WhatsApp</label>
                                        <input id="sp-hp" type="tel" name="noHp" required placeholder="Contoh: 0812xxxxxxxx">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="sp-alamat">Alamat Lengkap</label>
                                    <textarea id="sp-alamat" name="alamat" rows="3" required placeholder="Tuliskan alamat tempat tinggal Anda"></textarea>
                                </div>
                                <div class="form-group">
                                    <label for="sp-catatan">Catatan Tambahan <span class="optional">(opsional)</span></label>
                                    <textarea id="sp-catatan" name="catatan" rows="3" placeholder="Tulis kebutuhan atau dokumen tambahan jika ada"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-block">Kirim Pengajuan</button>
                            </form>
                        <% } else { %>
                            <div class="callout">
                                <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'lock' }) %></span>
                                <div>
                                    <h3>Masuk terlebih dahulu</h3>
                                    <p>Silakan <a href="/login">masuk</a> atau <a href="/register">daftar akun</a> untuk mengajukan surat pengantar.</p>
                                </div>
                            </div>
                        <% } %>
                    </article>
                <% } %>

                <% if (layanan.slug === 'kontak-darurat') { %>
                    <article class="card card-highlight">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title">Nomor Kontak Darurat</h2>
                                <p class="card-subtitle">Hubungi salah satu nomor berikut bila Anda membutuhkan bantuan segera.</p>
                            </div>
                        </div>
                        <% if (layanan.detail.kontak && layanan.detail.kontak.length > 0) { %>
                            <div class="grid grid-3">
                                <% layanan.detail.kontak.forEach(function(item) {
                                    const phoneNumber = item.nilai ? item.nilai.replace(/\D/g, '') : '';
                                    const waNumber = phoneNumber.replace(/^0/, '62');
                                %>
                                    <div class="contact-card">
                                        <span class="label"><%= item.jenis %></span>
                                        <span class="value"><%= item.nilai %></span>
                                        <div class="actions">
                                            <a href="tel:<%= phoneNumber %>" class="btn btn-primary btn-sm"><%- include('partials/icon', { name: 'phone' }) %> Panggil</a>
                                            <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">WhatsApp</a>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="empty-text">Nomor darurat belum tersedia. Silakan kunjungi kantor desa untuk informasi lebih lanjut.</p>
                        <% } %>
                    </article>
                <% } %>

                <% if (layanan.slug === 'layanan-kesehatan') {
                    const daftarKesehatan = (typeof layananKesehatan !== 'undefined' && Array.isArray(layananKesehatan)) ? layananKesehatan : [];
                %>
                    <article class="card card-highlight">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'health' }) %></span> Jadwal &amp; Layanan Kesehatan Desa</h2>
                                <p class="card-subtitle">Informasi jadwal Posyandu, imunisasi, pemeriksaan, dan layanan ambulans aktif di <%= desa.nama %>.</p>
                            </div>
                            <span class="badge badge-primary"><%= daftarKesehatan.length %> layanan aktif</span>
                        </div>

                        <% if (daftarKesehatan.length > 0) { %>
                            <div class="item-list">
                                <% daftarKesehatan.forEach(function(item) {
                                    const phoneNumber = item.kontak ? String(item.kontak).replace(/\D/g, '') : '';
                                    const waNumber = phoneNumber.replace(/^0/, '62');
                                %>
                                    <div class="item is-secondary">
                                        <div class="item-head">
                                            <span class="item-title"><%= item.nama_layanan %></span>
                                            <span class="badge badge-success"><%= item.kategori %></span>
                                        </div>
                                        <div class="item-meta">
                                            <span><strong>Jadwal:</strong> <%= item.jadwal %></span>
                                            <span><strong>Lokasi:</strong> <%= item.lokasi %></span>
                                            <% if (item.petugas) { %><span><strong>Petugas:</strong> <%= item.petugas %></span><% } %>
                                        </div>
                                        <% if (item.keterangan) { %>
                                            <p class="item-body"><%= item.keterangan %></p>
                                        <% } %>
                                        <% if (phoneNumber) { %>
                                            <div class="item-actions">
                                                <a href="tel:<%= phoneNumber %>" class="btn btn-primary btn-sm"><%- include('partials/icon', { name: 'phone' }) %> Hubungi (<%= item.kontak %>)</a>
                                                <a href="https://wa.me/<%= waNumber %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">WhatsApp</a>
                                            </div>
                                        <% } %>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="empty-text">Jadwal layanan kesehatan belum tersedia. Silakan hubungi kantor desa untuk informasi terbaru.</p>
                        <% } %>
                    </article>
                <% } %>

                <% if (layanan.slug === 'bantuan-sosial') {
                    const daftarBantuan = (typeof penerimaBantuan !== 'undefined' && Array.isArray(penerimaBantuan)) ? penerimaBantuan : [];
                    const formatRp = n => 'Rp ' + Math.abs(Number(n) || 0).toLocaleString('id-ID');
                    const maskNik = nik => {
                        const s = String(nik || '').trim();
                        if (s.length <= 6) return s;
                        return s.slice(0, 4) + '••••••' + s.slice(-4);
                    };
                %>
                    <article class="card card-highlight">
                        <div class="card-header">
                            <div>
                                <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'heart' }) %></span> Daftar Warga Penerima Bantuan</h2>
                                <p class="card-subtitle">Daftar warga yang telah diverifikasi oleh pemerintah <%= desa.nama %> untuk menerima bantuan sosial.</p>
                            </div>
                            <span class="badge badge-primary"><%= daftarBantuan.length %> penerima</span>
                        </div>

                        <% if (daftarBantuan.length > 0) { %>
                            <div class="pop-table-wrap table-responsive-cards">
                                <table class="pop-table fin-table">
                                    <thead>
                                        <tr>
                                            <th>Nama Warga &amp; Dusun</th>
                                            <th>Program Bantuan</th>
                                            <th>Kriteria</th>
                                            <th>Nilai</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% daftarBantuan.forEach(function(item) {
                                            const isSalur = item.status === 'Tersalurkan';
                                        %>
                                            <tr>
                                                <td data-label="Nama Warga">
                                                    <div>
                                                        <strong class="fin-row-cat"><%= item.nama %></strong>
                                                        <small class="fin-row-date">NIK: <%= maskNik(item.nik) %> · <strong><%= item.dusun %></strong></small>
                                                    </div>
                                                </td>
                                                <td data-label="Program">
                                                    <div>
                                                        <strong class="fin-row-cat"><%= item.jenis_bantuan %></strong>
                                                        <small class="fin-row-date"><%= item.tanggal %></small>
                                                    </div>
                                                </td>
                                                <td data-label="Kriteria"><span><%= item.kriteria %></span></td>
                                                <td data-label="Nilai" class="fin-amount is-income"><span><%= formatRp(item.nominal) %></span></td>
                                                <td data-label="Status">
                                                    <span class="badge <%= isSalur ? 'badge-success' : 'badge-warning' %>">
                                                        <%= item.status %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="empty-text">Belum ada data warga penerima bantuan yang dipublikasikan.</p>
                        <% } %>
                    </article>
                <% } %>
            </div>

            <aside class="stack sticky-aside" aria-label="Layanan lainnya">
                <div class="card">
                    <h2 class="card-title mb-16">Daftar Layanan</h2>
                    <nav class="side-nav">
                        <% desa.layanan.forEach(function(item) { %>
                            <a href="/layanan/<%= item.slug %>" class="<%= item.slug === layanan.slug ? 'is-active' : '' %>"><%= item.nama %> <span aria-hidden="true">›</span></a>
                        <% }); %>
                        <a href="/layanan/pengaduan">Pengaduan &amp; Aspirasi <span aria-hidden="true">›</span></a>
                    </nav>
                </div>
                <div class="callout">
                    <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'building' }) %></span>
                    <div>
                        <h3>Butuh bantuan?</h3>
                        <p>Kunjungi kantor desa pada jam kerja atau hubungi petugas melalui <a href="/layanan/kontak-darurat">kontak desa</a>.</p>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
