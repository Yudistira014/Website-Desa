<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masuk - Portal Desa</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <link rel="stylesheet" href="/style.css">

  <style>
    /* ── Auth Page Layout ─────────────────────────── */
    .auth-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: #f0fdf4;
    }

    /* ── Split Card ───────────────────────────────── */
    .auth-card {
      width: 100%;
      max-width: 820px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 32px 80px rgba(4,120,87,0.13), 0 8px 24px rgba(0,0,0,0.06);
      border: 1px solid var(--border-color, rgba(15, 23, 42, 0.08));
    }

    /* ── Panel Kiri ───────────────────────────────── */
    .auth-left {
      background: var(--primary-color, #047857);
      padding: 3rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .auth-left::before {
      content: '';
      position: absolute;
      width: 300px; height: 300px;
      border-radius: 50%;
      border: 58px solid rgba(255,255,255,0.07);
      top: -80px; right: -80px;
      pointer-events: none;
    }

    .auth-left::after {
      content: '';
      position: absolute;
      width: 180px; height: 180px;
      border-radius: 50%;
      border: 36px solid rgba(255,255,255,0.07);
      bottom: -30px; left: -30px;
      pointer-events: none;
    }

    .auth-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.14);
      border: 1px solid rgba(255,255,255,0.22);
      border-radius: 999px;
      padding: 6px 14px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 1.3px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.9);
      width: fit-content;
      position: relative;
      z-index: 1;
    }

    .auth-left-body {
      position: relative;
      z-index: 1;
      margin-top: 1.5rem;
    }

    .auth-left-title {
      color: #fff;
      font-size: 1.55rem;
      font-weight: 700;
      line-height: 1.35;
      margin-bottom: 0.7rem;
    }

    .auth-left-sub {
      color: rgba(255,255,255,0.68);
      font-size: 0.82rem;
      line-height: 1.75;
    }

    .auth-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      z-index: 1;
      padding-left: 0;
      margin-top: 2rem;
    }

    .auth-feature-item {
      display: flex;
      align-items: center;
      gap: 10px;
      color: rgba(255,255,255,0.82);
      font-size: 0.8rem;
      font-weight: 500;
    }

    .auth-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: #6ee7b7;
      flex-shrink: 0;
    }

    /* ── Panel Kanan ──────────────────────────────── */
    .auth-right {
      background: var(--bg-main, #ffffff);
      padding: 3rem 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .auth-heading {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--primary-dark, #064e3b);
      margin-bottom: 4px;
    }

    .auth-subheading {
      font-size: 0.8rem;
      color: var(--text-light, #64748b);
      margin-bottom: 1.75rem;
    }

    /* ── Alert ────────────────────────────────────── */
    .auth-alert {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.82rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }

    .auth-alert-error {
      background: #fee2e2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    .auth-alert-success {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    /* ── Field ────────────────────────────────────── */
    .auth-field { margin-bottom: 1.1rem; }

    .auth-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-light, #64748b);
      letter-spacing: 0.6px;
      text-transform: uppercase;
      margin-bottom: 7px;
    }

    .auth-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .auth-icon {
      position: absolute;
      left: 13px;
      font-size: 0.95rem;
      color: var(--text-light, #64748b);
      pointer-events: none;
      z-index: 1;
    }

    .auth-input-wrap input {
      width: 100%;
      padding: 11px 42px 11px 38px;
      border: 1px solid var(--border-color, rgba(15, 23, 42, 0.08));
      border-radius: 10px;
      font-family: var(--font-main, 'Poppins', sans-serif);
      font-size: 0.875rem;
      background: var(--bg-light, #f8fafc);
      color: var(--text-main, #334155);
      outline: none;
      transition: var(--transition, all 0.3s ease);
    }

    .auth-input-wrap input:focus {
      border-color: var(--primary-color, #047857);
      box-shadow: 0 0 0 3px rgba(4,120,87,0.12);
      background: var(--bg-main, #ffffff);
    }

    .auth-eye {
      position: absolute;
      right: 10px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 0.92rem;
      color: var(--text-light, #64748b);
      padding: 5px;
      border-radius: 6px;
      line-height: 1;
      transition: var(--transition, all 0.3s ease);
    }

    .auth-eye:hover { color: var(--primary-color, #047857); }

    .auth-forgot {
      display: block;
      text-align: right;
      font-size: 0.75rem;
      color: var(--primary-color, #047857);
      font-weight: 600;
      margin-top: 6px;
      text-decoration: none;
    }

    .auth-forgot:hover { text-decoration: underline; }

    /* ── Submit Button ────────────────────────────── */
    .auth-btn {
      width: 100%;
      padding: 13px;
      background: var(--primary-color, #047857);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 0.9rem;
      font-weight: 700;
      font-family: var(--font-main, 'Poppins', sans-serif);
      cursor: pointer;
      margin-top: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      letter-spacing: 0.3px;
      transition: background 0.25s ease, transform 0.15s ease, box-shadow 0.25s ease;
    }

    .auth-btn:hover {
      background: var(--primary-dark, #064e3b);
      transform: translateY(-1px);
      box-shadow: 0 10px 28px rgba(4,120,87,0.28);
    }

    .auth-btn:active {
      transform: translateY(0);
      box-shadow: none;
    }

    /* ── Bottom Links ─────────────────────────────── */
    .auth-links {
      text-align: center;
      margin-top: 1.5rem;
    }

    .auth-links p {
      font-size: 0.8rem;
      color: var(--text-light, #64748b);
      margin-bottom: 6px;
    }

    .auth-links a {
      color: var(--primary-color, #047857);
      font-weight: 600;
      text-decoration: none;
    }

    .auth-links a:hover { text-decoration: underline; }

    /* ── Responsive ───────────────────────────────── */
    @media (max-width: 620px) {
      .auth-page { padding: 1rem; align-items: flex-start; padding-top: 2rem; }
      .auth-card  { grid-template-columns: 1fr; max-width: 420px; border-radius: 20px; }
      .auth-left  { display: none; }
      .auth-right { padding: 2rem 1.75rem; }
    }

    @media (max-width: 380px) {
      .auth-right { padding: 1.75rem 1.25rem; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0;">

  <div class="auth-page">
    <div class="auth-card">
      
      <div class="auth-left">
        <div>
          <div class="auth-badge">
            <i class="fas fa-shield-alt"></i> Portal Desa
          </div>
          <div class="auth-left-body">
            <h1 class="auth-left-title">Selamat Datang<br>Kembali</h1>
            <p class="auth-left-sub">Silakan masuk untuk melanjutkan akses ke layanan administrasi dan informasi desa Anda.</p>
          </div>
        </div>
        
        <ul class="auth-features">
          <li class="auth-feature-item"><div class="auth-dot"></div> Layanan Administrasi Mandiri</li>
          <li class="auth-feature-item"><div class="auth-dot"></div> Pantau Status Pelaporan</li>
          <li class="auth-feature-item"><div class="auth-dot"></div> Informasi Desa Terkini</li>
        </ul>
      </div>

      <div class="auth-right">
        <h2 class="auth-heading">Masuk ke Akun</h2>
        <p class="auth-subheading">Masukkan username dan kata sandi Anda.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="auth-alert auth-alert-error">
            <i class="fas fa-exclamation-circle"></i> <%= error %>
          </div>
        <% } %>
        
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="auth-alert auth-alert-success">
            <i class="fas fa-check-circle"></i> <%= success %>
          </div>
        <% } %>

        <form action="/login" method="POST">
          
          <div class="auth-field">
            <label class="auth-label">Username</label>
            <div class="auth-input-wrap">
              <i class="auth-icon fas fa-user"></i>
              <input type="text" name="username" required placeholder="Masukkan username Anda">
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label">Kata Sandi</label>
            <div class="auth-input-wrap">
              <i class="auth-icon fas fa-lock"></i>
              <input type="password" name="password" id="login-pwd" required placeholder="Masukkan kata sandi">
              <button type="button" class="auth-eye" onclick="togglePassword('login-pwd')">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="auth-btn">
            Masuk <i class="fas fa-sign-in-alt"></i>
          </button>
        </form>

        <div class="auth-links">
          <p>Belum punya akun? <a href="/register">Daftar di sini</a></p>
          <p><a href="/">&larr; Kembali ke Beranda</a></p>
        </div>

      </div>
    </div>
  </div>

  <script>
    function togglePassword(inputId) {
      const input = document.getElementById(inputId);
      const icon = input.nextElementSibling.querySelector('i');
      
      if (input.type === "password") {
        input.type = "text";
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = "password";
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>

</body>
</html>