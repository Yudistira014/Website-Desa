<% const data = desa.pemerintahan.bpd; %>
<%- include('partials/head', { title: 'BPD', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'pemerintahan', activeSub: '/pemerintahan/bpd' }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: data.judul,
        lead: data.deskripsi,
        crumbs: [{ label: 'Pemerintahan', href: '/pemerintahan/desa' }, { label: 'BPD' }]
    }) %>
    <%- include('partials/subnav', {
        tabs: [{ label: 'Pemerintah Desa', href: '/pemerintahan/desa' }, { label: 'BPD', href: '/pemerintahan/bpd' }, { label: 'LPMD', href: '/pemerintahan/lpmd' }],
        current: '/pemerintahan/bpd'
    }) %>

    <section class="section">
        <div class="container stack">
            <div class="grid grid-2">
                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'users' }) %></span> Peran BPD</h2>
                    </div>
                    <p>BPD adalah mitra kerja pemerintah desa yang bertugas menjadi perwakilan masyarakat dalam pengambilan keputusan penting, memastikan transparansi, dan menjaga aspirasi warga.</p>
                </article>

                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'megaphone' }) %></span> Cara Menyampaikan Aspirasi</h2>
                    </div>
                    <p>Aspirasi masyarakat dapat disampaikan langsung ke perwakilan BPD, melalui surat resmi, maupun melalui forum musyawarah desa. BPD akan menindaklanjuti aspirasi tersebut pada rapat dan perencanaan desa.</p>
                </article>
            </div>

            <article class="card">
                <div class="card-header">
                    <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'clipboard' }) %></span> Tugas Pokok BPD</h2>
                    <span class="badge badge-primary"><%= data.tugas.length %> tugas</span>
                </div>
                <ol class="list-number">
                    <% data.tugas.forEach(function(item) { %>
                        <li><span><%= item %></span></li>
                    <% }); %>
                </ol>
            </article>

            <div class="cta-band">
                <div>
                    <h3>Ingin menyampaikan aspirasi?</h3>
                    <p>Kirim saran atau keluhan Anda secara daring melalui portal desa.</p>
                </div>
                <a href="/layanan/pengaduan" class="btn btn-light">Sampaikan Aspirasi <%- include('partials/icon', { name: 'arrow-right' }) %></a>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
