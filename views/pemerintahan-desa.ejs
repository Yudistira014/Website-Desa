<% const data = desa.pemerintahan.desa; %>
<%- include('partials/head', { title: data.judul, bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'pemerintahan', activeSub: '/pemerintahan/desa' }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: data.judul,
        lead: data.deskripsi,
        crumbs: [{ label: 'Pemerintahan', href: '/pemerintahan/desa' }, { label: 'Pemerintah Desa' }]
    }) %>
    <%- include('partials/subnav', {
        tabs: [{ label: 'Pemerintah Desa', href: '/pemerintahan/desa' }, { label: 'BPD', href: '/pemerintahan/bpd' }, { label: 'LPMD', href: '/pemerintahan/lpmd' }],
        current: '/pemerintahan/desa'
    }) %>

    <section class="section">
        <div class="container stack">
            <article class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'building' }) %></span> Struktur Pemerintahan Desa</h2>
                    </div>
                    <span class="badge badge-primary"><%= data.struktur.length %> jabatan</span>
                </div>
                <ul class="tile-list">
                    <% data.struktur.forEach(function(posisi, index) { %>
                        <li class="tile">
                            <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: index === 0 ? 'user' : 'users' }) %></span>
                            <span><%= posisi %><% if (index === 0) { %><small><%= desa.kepalaDesa %></small><% } %></span>
                        </li>
                    <% }); %>
                </ul>
            </article>

            <div class="grid grid-2">
                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'clipboard' }) %></span> Tugas &amp; Fungsi Utama</h2>
                    </div>
                    <ul class="list-check">
                        <% data.tugas.forEach(function(item) { %>
                            <li><%= item %></li>
                        <% }); %>
                    </ul>
                </article>

                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'heart' }) %></span> Nilai Pelayanan Kami</h2>
                    </div>
                    <p><%= desa.nama %> berkomitmen melayani masyarakat dengan pendekatan yang terbuka, cepat, dan profesional. Setiap warga didorong untuk turut serta memberi masukan demi pembangunan desa.</p>
                    <div class="callout mt-24">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chat' }) %></span>
                        <div>
                            <h3>Punya masukan?</h3>
                            <p>Sampaikan melalui <a href="/layanan/pengaduan">layanan pengaduan &amp; aspirasi</a>.</p>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
