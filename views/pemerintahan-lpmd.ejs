<% const data = desa.pemerintahan.lpmd; %>
<%- include('partials/head', { title: 'LPMD', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'pemerintahan', activeSub: '/pemerintahan/lpmd' }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: data.judul,
        lead: data.deskripsi,
        crumbs: [{ label: 'Pemerintahan', href: '/pemerintahan/desa' }, { label: 'LPMD' }]
    }) %>
    <%- include('partials/subnav', {
        tabs: [{ label: 'Pemerintah Desa', href: '/pemerintahan/desa' }, { label: 'BPD', href: '/pemerintahan/bpd' }, { label: 'LPMD', href: '/pemerintahan/lpmd' }],
        current: '/pemerintahan/lpmd'
    }) %>

    <section class="section">
        <div class="container stack">
            <div class="grid grid-2">
                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'compass' }) %></span> Fokus Pemberdayaan</h2>
                    </div>
                    <p>LPMD bekerja bersama warga untuk memperkuat ekonomi lokal, membangun kolaborasi kelompok, dan mendorong kegiatan produktif yang memberi dampak nyata.</p>
                </article>

                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chart' }) %></span> Manfaat untuk Warga</h2>
                    </div>
                    <p>Program pelatihan usaha, pendampingan kelompok tani, dan kegiatan unggulan membantu warga mengembangkan potensi serta meningkatkan kesejahteraan di <%= desa.nama %>.</p>
                </article>
            </div>

            <article class="card" id="agenda">
                <div class="card-header">
                    <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'calendar' }) %></span> Agenda Utama</h2>
                    <span class="badge badge-primary"><%= data.tugas.length %> program</span>
                </div>
                <ol class="list-number">
                    <% data.tugas.forEach(function(item) { %>
                        <li><span><%= item %></span></li>
                    <% }); %>
                </ol>
            </article>

            <div class="cta-band">
                <div>
                    <h3>Ikut berkontribusi untuk desa</h3>
                    <p>Usulkan program pemberdayaan atau sampaikan masukan Anda kepada LPMD.</p>
                </div>
                <a href="/layanan/pengaduan" class="btn btn-light">Sampaikan Aspirasi <%- include('partials/icon', { name: 'arrow-right' }) %></a>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
