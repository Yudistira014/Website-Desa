<%- include('partials/head', { title: 'Pengaduan & Aspirasi', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'layanan', activeSub: '/layanan/pengaduan' }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: 'Pengaduan & Aspirasi',
        lead: 'Ajukan keluhan, saran, atau permintaan informasi kepada pemerintah desa secara langsung.',
        crumbs: [{ label: 'Layanan', href: '/#layanan' }, { label: 'Pengaduan & Aspirasi' }]
    }) %>

    <section class="section">
        <div class="container container-narrow stack">
            <div class="grid grid-2">
                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'clipboard' }) %></span> Cara Mengajukan</h2>
                    </div>
                    <ol class="list-number">
                        <li><span>Masuk dengan akun warga, lalu buka menu <strong>Dashboard</strong>.</span></li>
                        <li><span>Pilih jenis laporan: Saran, Keluhan/Pengaduan, atau Permohonan Informasi.</span></li>
                        <li><span>Tuliskan detail dengan jelas dan lampirkan foto bila perlu agar cepat ditindaklanjuti.</span></li>
                    </ol>
                </article>

                <article class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chat' }) %></span> Contoh Laporan</h2>
                    </div>
                    <ul class="list-check">
                        <li>Kerusakan fasilitas umum</li>
                        <li>Pelayanan administrasi yang lambat</li>
                        <li>Permintaan informasi bantuan sosial</li>
                        <li>Saran peningkatan program desa</li>
                    </ul>
                </article>
            </div>

            <div class="cta-band">
                <% if (user) { %>
                    <div>
                        <h3>Mulai pengaduan</h3>
                        <p>Anda masuk sebagai <strong><%= user.username %></strong>. Kirim laporan melalui dashboard Anda.</p>
                    </div>
                    <a href="/<%= user.role %>" class="btn btn-light">Buka Dashboard <%- include('partials/icon', { name: 'arrow-right' }) %></a>
                <% } else { %>
                    <div>
                        <h3>Mulai pengaduan</h3>
                        <p>Silakan masuk sebagai warga terlebih dahulu agar pengaduan dapat kami proses.</p>
                    </div>
                    <a href="/login" class="btn btn-light">Masuk Sekarang <%- include('partials/icon', { name: 'arrow-right' }) %></a>
                <% } %>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
