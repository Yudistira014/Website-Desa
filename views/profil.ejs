<%- include('partials/head', { title: 'Visi & Misi', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'profil', activeSub: '/profil/visi-misi' }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: 'Visi & Misi',
        lead: 'Cita-cita dan arah kebijakan pembangunan ' + desa.nama + '.',
        crumbs: [{ label: 'Profil Desa', href: '/profil' }, { label: 'Visi & Misi' }]
    }) %>
    <%- include('partials/subnav', {
        tabs: [{ label: 'Visi & Misi', href: '/profil/visi-misi' }, { label: 'Wilayah Desa', href: '/profil/wilayah-desa' }],
        current: '/profil/visi-misi'
    }) %>

    <section class="section">
        <div class="container container-narrow stack">
            <div class="quote-card">
                <span class="eyebrow">Visi</span>
                <blockquote>“<%= desa.visi %>”</blockquote>
            </div>

            <article class="card">
                <div class="card-header">
                    <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'target' }) %></span> Misi</h2>
                    <span class="badge badge-primary"><%= desa.misi.length %> poin</span>
                </div>
                <ol class="list-number">
                    <% desa.misi.forEach(function(item) { %>
                        <li><span><%= item %></span></li>
                    <% }); %>
                </ol>
            </article>

            <div class="cta-band">
                <div>
                    <h3>Kenali wilayah desa kami</h3>
                    <p>Lihat kondisi geografis dan pembagian dusun di <%= desa.nama %>.</p>
                </div>
                <a href="/profil/wilayah-desa" class="btn btn-light">Wilayah Desa <%- include('partials/icon', { name: 'arrow-right' }) %></a>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
