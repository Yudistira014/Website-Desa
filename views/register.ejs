<%- include('partials/head', { title: 'Daftar Akun' }) %>

<main class="auth-page" id="konten">
    <div class="auth-card">
        <aside class="auth-aside">
            <a href="/" class="auth-brand">
                <img src="/uploads/Logo_desa.png" alt="Logo <%= desa.nama %>">
                <span class="auth-brand-text">
                    <strong><%= desa.nama %></strong>
                    <small>Portal Resmi Pemerintah Desa</small>
                </span>
            </a>

            <div>
                <span class="auth-pill"><span class="auth-pill-dot"></span> Pendaftaran Warga</span>
                <h1>Bergabung Bersama Kami</h1>
                <p>Akses berbagai layanan administrasi secara digital, kapan saja dan di mana saja. Lebih cepat dan transparan.</p>
            </div>

            <ul class="auth-features">
                <li>
                    <span class="auth-feature-icon"><%- include('partials/icon', { name: 'check-circle' }) %></span>
                    <span>Pendaftaran Cepat &amp; Mudah</span>
                </li>
                <li>
                    <span class="auth-feature-icon"><%- include('partials/icon', { name: 'lock' }) %></span>
                    <span>Keamanan Data Terjamin</span>
                </li>
                <li>
                    <span class="auth-feature-icon"><%- include('partials/icon', { name: 'document' }) %></span>
                    <span>Layanan Mandiri 24 Jam</span>
                </li>
            </ul>
        </aside>

        <section class="auth-main">
            <a href="/" class="auth-mobile-brand">
                <img src="/uploads/Logo_desa.png" alt="Logo <%= desa.nama %>">
                <div>
                    <strong><%= desa.nama %></strong>
                    <small>Portal Resmi Pemerintah Desa</small>
                </div>
            </a>

            <div class="auth-header">
                <span class="eyebrow">Akun Baru</span>
                <h2>Daftar Akun Warga</h2>
                <p>Lengkapi formulir di bawah ini untuk membuat akun.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error" role="alert">
                    <%- include('partials/icon', { name: 'alert-circle' }) %>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label for="reg-username">Username Baru</label>
                    <div class="input-wrap">
                        <%- include('partials/icon', { name: 'user', cls: 'input-icon' }) %>
                        <input type="text" name="username" id="reg-username" autocomplete="username" required placeholder="Pilih username unik">
                    </div>
                </div>

                <div class="form-group">
                    <label for="reg-pwd">Kata Sandi</label>
                    <div class="input-wrap has-toggle">
                        <%- include('partials/icon', { name: 'lock', cls: 'input-icon' }) %>
                        <input type="password" name="password" id="reg-pwd" autocomplete="new-password" required placeholder="Buat kata sandi">
                        <button type="button" class="password-toggle" aria-label="Tampilkan kata sandi" aria-pressed="false" data-toggle-password="reg-pwd">
                            <%- include('partials/icon', { name: 'eye', cls: 'icon-show' }) %>
                            <%- include('partials/icon', { name: 'eye-off', cls: 'icon-hide' }) %>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="reg-pwd-confirm">Konfirmasi Kata Sandi</label>
                    <div class="input-wrap has-toggle">
                        <%- include('partials/icon', { name: 'check-circle', cls: 'input-icon' }) %>
                        <input type="password" name="confirmPassword" id="reg-pwd-confirm" autocomplete="new-password" required placeholder="Ulangi kata sandi">
                        <button type="button" class="password-toggle" aria-label="Tampilkan kata sandi" aria-pressed="false" data-toggle-password="reg-pwd-confirm">
                            <%- include('partials/icon', { name: 'eye', cls: 'icon-show' }) %>
                            <%- include('partials/icon', { name: 'eye-off', cls: 'icon-hide' }) %>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block auth-submit">
                    <span>Daftar Sekarang</span>
                    <%- include('partials/icon', { name: 'arrow-right' }) %>
                </button>
            </form>

            <div class="auth-footer">
                <p>Sudah punya akun? <a href="/login">Masuk di sini</a></p>
                <p>
                    <a href="/" class="auth-back-link">
                        <%- include('partials/icon', { name: 'arrow-left' }) %>
                        <span>Kembali ke Beranda</span>
                    </a>
                </p>
            </div>
        </section>
    </div>
</main>

<script>
    document.querySelectorAll('[data-toggle-password]').forEach(btn => {
        btn.addEventListener('click', () => {
            const input = document.getElementById(btn.dataset.togglePassword);
            if (!input) return;
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.setAttribute('aria-pressed', String(show));
            btn.setAttribute('aria-label', show ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
        });
    });
</script>
</body>
</html>
