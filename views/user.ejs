<%- include('partials/head', { title: 'Dashboard Warga', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar-dashboard', { active: 'dashboard' }) %>

<%
const imgSrc = foto => /^https?:\/\//i.test(foto) ? foto : '/' + foto;
const daftarLaporan = laporan || [];
const daftarSurat = suratPengantar || [];
const daftarBantuan = (typeof penerimaBantuan !== 'undefined' && Array.isArray(penerimaBantuan)) ? penerimaBantuan : [];
const statusBadge = status => status === 'Ditolak' ? 'badge-danger' : (status === 'Disetujui' ? 'badge-success' : 'badge-warning');
const formatRp = n => 'Rp ' + Math.abs(Number(n) || 0).toLocaleString('id-ID');
const maskNik = nik => {
    const s = String(nik || '').trim();
    if (s.length <= 6) return s;
    return s.slice(0, 4) + '••••••' + s.slice(-4);
};
%>

<main id="konten">
    <header class="dash-header">
        <div class="container dash-header-inner">
            <div>
                <span class="eyebrow">Layanan Mandiri Warga</span>
                <h1>Halo, <%= user.username %>!</h1>
                <p>Kirim laporan dan pantau pengajuan surat Anda di <%= desa.nama %>.</p>
            </div>
            <a href="/layanan/surat-pengantar#form-pengajuan" class="btn btn-primary"><%- include('partials/icon', { name: 'document' }) %> Ajukan Surat</a>
        </div>
    </header>

    <div class="dash-body">
        <div class="container">
            <% if (error) { %>
                <div class="alert alert-error" role="alert"><%- include('partials/icon', { name: 'alert-circle' }) %> <%= error %></div>
            <% } %>

            <div class="dash-grid">
                <!-- Form laporan -->
                <section class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'chat' }) %></span> Kirim Aspirasi &amp; Laporan</h2>
                    </div>
                    <form action="/user/kirim-laporan" method="POST" enctype="multipart/form-data">
                        <div class="form-group">
                            <label for="laporan-tipe">Tipe Laporan</label>
                            <select id="laporan-tipe" name="tipe" required>
                                <option value="Saran">Saran</option>
                                <option value="Keluhan">Keluhan/Pengaduan</option>
                                <option value="Permohonan">Permohonan Informasi</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="laporan-isi">Isi Laporan</label>
                            <textarea id="laporan-isi" name="isi" rows="5" required placeholder="Tuliskan detail laporan Anda di sini..."></textarea>
                        </div>
                        <div class="form-group">
                            <label for="laporan-foto">Foto Pendukung <span class="optional">(opsional)</span></label>
                            <input id="laporan-foto" type="file" name="fotoLaporan" accept="image/*">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Kirim Laporan</button>
                    </form>
                </section>

                <!-- Riwayat laporan -->
                <section class="card">
                    <div class="card-header">
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'inbox' }) %></span> Riwayat Laporan Saya</h2>
                        <span class="badge"><%= daftarLaporan.length %></span>
                    </div>
                    <div class="scroll-area">
                        <% if (daftarLaporan.length > 0) { %>
                            <div class="item-list">
                                <% daftarLaporan.forEach(function(item) { %>
                                    <article class="item">
                                        <div class="item-head">
                                            <span class="badge badge-primary"><%= item.tipe %></span>
                                            <span class="item-meta"><%= item.tanggal %></span>
                                        </div>
                                        <p><%= item.isi %></p>
                                        <% if (item.foto) { %>
                                            <img class="item-image" src="<%= imgSrc(item.foto) %>" alt="Foto laporan" loading="lazy">
                                        <% } %>
                                        <div class="item-actions">
                                            <a href="/user/edit-laporan/<%= item.id %>" class="btn btn-outline btn-sm"><%- include('partials/icon', { name: 'edit' }) %> Edit</a>
                                            <form action="/user/hapus-laporan/<%= item.id %>" method="POST" data-confirm-title="Hapus Laporan Anda?" data-confirm="Apakah Anda yakin ingin menghapus laporan <%= item.tipe %> ini?">
                                                <button type="submit" class="btn btn-danger-soft btn-sm"><%- include('partials/icon', { name: 'trash' }) %> Hapus</button>
                                            </form>
                                        </div>
                                    </article>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="empty-text">Anda belum pernah mengirim laporan.</p>
                        <% } %>
                    </div>
                </section>
            </div>

            <!-- Riwayat surat -->
            <section class="card">
                <div class="card-header">
                    <div>
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'document' }) %></span> Riwayat Surat Pengantar</h2>
                        <p class="card-subtitle">Pantau status pengajuan surat pengantar Anda.</p>
                    </div>
                    <span class="badge"><%= daftarSurat.length %></span>
                </div>
                <div class="scroll-area">
                    <% if (daftarSurat.length > 0) { %>
                        <div class="item-list">
                            <% daftarSurat.forEach(function(surat) {
                                const status = surat.status || 'Menunggu';
                            %>
                                <article class="item <%= status === 'Ditolak' ? 'is-danger' : 'is-secondary' %>">
                                    <div class="item-head">
                                        <span class="item-title"><%= surat.keperluan %></span>
                                        <span class="badge <%= statusBadge(status) %>"><%= status %></span>
                                    </div>
                                    <div class="item-meta">
                                        <span><%= surat.tanggal %></span>
                                        <span><strong>NIK:</strong> <%= surat.nik %></span>
                                        <span><strong>HP:</strong> <%= surat.no_hp %></span>
                                    </div>
                                    <p><strong>Alamat:</strong> <%= surat.alamat %></p>
                                    <% if (surat.catatan) { %>
                                        <p><strong>Catatan:</strong> <%= surat.catatan %></p>
                                    <% } %>
                                    <% if (status === 'Ditolak' && surat.alasan_penolakan) { %>
                                        <p class="item-note-danger"><strong>Alasan penolakan:</strong> <%= surat.alasan_penolakan %></p>
                                    <% } %>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                    <p class="empty-text">Belum ada pengajuan surat pengantar.</p>
                <% } %>
                </div>
            </section>

            <!-- Daftar Warga Penerima Bantuan Desa -->
            <section class="card" id="penerima-bantuan">
                <div class="card-header">
                    <div>
                        <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'heart' }) %></span> Daftar Warga Penerima Bantuan Desa</h2>
                        <p class="card-subtitle">Transparansi daftar warga yang terdaftar menerima program bantuan sosial <%= desa.nama %>.</p>
                    </div>
                    <div class="user-aid-controls">
                        <input type="search" id="user-aid-search" class="form-control user-aid-search" placeholder="Cari nama warga atau dusun..." aria-label="Cari warga penerima bantuan">
                        <span class="badge badge-primary"><%= daftarBantuan.length %> penerima</span>
                    </div>
                </div>

                <% if (daftarBantuan.length > 0) { %>
                    <div class="pop-table-wrap table-responsive-cards">
                        <table class="pop-table fin-table" id="user-aid-table">
                            <thead>
                                <tr>
                                    <th>Nama Warga &amp; Wilayah</th>
                                    <th>Program Bantuan</th>
                                    <th>Kriteria</th>
                                    <th>Nilai Bantuan</th>
                                    <th>Status Penyaluran</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% daftarBantuan.forEach(function(item) {
                                    const isSalur = item.status === 'Tersalurkan';
                                    const isCurrentUser = user && item.nama && item.nama.toLowerCase() === user.username.toLowerCase();
                                %>
                                    <tr data-aid-search="<%= (item.nama + ' ' + item.dusun + ' ' + item.jenis_bantuan + ' ' + item.kriteria).toLowerCase() %>" class="<%= isCurrentUser ? 'is-my-aid-row' : '' %>">
                                        <td data-label="Nama Warga">
                                            <div>
                                                <strong class="fin-row-cat">
                                                    <%= item.nama %>
                                                    <% if (isCurrentUser) { %><span class="badge badge-primary" style="margin-left: 6px;">Anda</span><% } %>
                                                </strong>
                                                <small class="fin-row-date">NIK: <%= maskNik(item.nik) %> · <strong><%= item.dusun %></strong></small>
                                            </div>
                                        </td>
                                        <td data-label="Program">
                                            <div>
                                                <strong class="fin-row-cat"><%= item.jenis_bantuan %></strong>
                                                <small class="fin-row-date">Didata: <%= item.tanggal %></small>
                                            </div>
                                        </td>
                                        <td data-label="Kriteria"><span><%= item.kriteria %></span></td>
                                        <td data-label="Nilai" class="fin-amount is-income"><span><%= formatRp(item.nominal) %></span></td>
                                        <td data-label="Status">
                                            <span class="badge <%= isSalur ? 'badge-success' : 'badge-warning' %>">
                                                <%= item.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <p class="empty-text" id="user-aid-empty-search" hidden>Tidak ditemukan warga dengan kata kunci tersebut.</p>
                <% } else { %>
                    <p class="empty-text">Belum ada daftar penerima bantuan desa yang dipublikasikan oleh admin.</p>
                <% } %>
            </section>

            <!-- Layanan cepat -->
            <section class="mt-32">
                <h2 class="card-title mb-16">Layanan Cepat</h2>
                <div class="quick-grid">
                    <a href="/layanan/surat-pengantar" class="card feature-card">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'document' }) %></span>
                        <div><h3>Surat Pengantar</h3><p>Urus dokumen kependudukan lebih cepat.</p></div>
                    </a>
                    <a href="/layanan/kontak-darurat" class="card feature-card">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'phone' }) %></span>
                        <div><h3>Kontak Darurat</h3><p>Hubungi petugas desa dalam keadaan darurat.</p></div>
                    </a>
                    <a href="/layanan/bantuan-sosial" class="card feature-card">
                        <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'heart' }) %></span>
                        <div><h3>Bantuan Sosial</h3><p>Informasi penyaluran BLT dan bantuan lainnya.</p></div>
                    </a>
                </div>
            </section>
        </div>
    </div>
</main>

<%- include('partials/footer', { simple: true }) %>
<script>
    (() => {
        const searchInput = document.getElementById('user-aid-search');
        const rows = document.querySelectorAll('#user-aid-table tbody tr[data-aid-search]');
        const emptyMsg = document.getElementById('user-aid-empty-search');
        if (!searchInput || !rows.length) return;

        searchInput.addEventListener('input', () => {
            const q = searchInput.value.trim().toLowerCase();
            let visible = 0;
            rows.forEach(row => {
                const match = !q || row.getAttribute('data-aid-search').includes(q);
                row.hidden = !match;
                if (match) visible++;
            });
            if (emptyMsg) emptyMsg.hidden = visible > 0;
        });
    })();
</script>
<%- include('partials/end') %>
