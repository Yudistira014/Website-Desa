<%- include('partials/head', { title: 'Wilayah Desa', bodyClass: 'page-muted' }) %>
<%- include('partials/navbar', { active: 'profil', activeSub: '/profil/wilayah-desa' }) %>

<main id="konten">
    <%- include('partials/page-header', {
        heading: 'Wilayah Desa',
        lead: 'Kondisi geografis dan struktur administratif ' + desa.nama + '.',
        crumbs: [{ label: 'Profil Desa', href: '/profil' }, { label: 'Wilayah Desa' }]
    }) %>
    <%- include('partials/subnav', {
        tabs: [{ label: 'Visi & Misi', href: '/profil/visi-misi' }, { label: 'Wilayah Desa', href: '/profil/wilayah-desa' }],
        current: '/profil/wilayah-desa'
    }) %>

    <section class="section">
        <div class="container container-narrow stack">
            <div class="grid grid-3">
                <div class="card stat-card">
                    <span class="icon-box"><%- include('partials/icon', { name: 'map' }) %></span>
                    <div><strong><%= desa.wilayah.dusun.length %></strong><span>Dusun</span></div>
                </div>
                <div class="card stat-card">
                    <span class="icon-box"><%- include('partials/icon', { name: 'users' }) %></span>
                    <div><strong><%= desa.populasi %></strong><span>Jiwa penduduk</span></div>
                </div>
                <div class="card stat-card">
                    <span class="icon-box"><%- include('partials/icon', { name: 'user' }) %></span>
                    <div><strong style="font-size: 1rem;"><%= desa.kepalaDesa %></strong><span>Kepala Desa</span></div>
                </div>
            </div>

            <article class="card">
                <div class="card-header">
                    <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'compass' }) %></span> Deskripsi Wilayah</h2>
                </div>
                <p><%= desa.wilayah.deskripsi %></p>
            </article>

            <article class="card">
                <div class="card-header">
                    <h2 class="card-title"><span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'map-pin' }) %></span> Dusun di <%= desa.nama %></h2>
                </div>
                <ul class="tile-list">
                    <% desa.wilayah.dusun.forEach(function(dusun, index) { %>
                        <li class="tile">
                            <span class="icon-box icon-box-sm"><%- include('partials/icon', { name: 'home' }) %></span>
                            <span><%= dusun %><small>Wilayah <%= index + 1 %></small></span>
                        </li>
                    <% }); %>
                </ul>
            </article>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/end') %>
